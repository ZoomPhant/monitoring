---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdminNav from '../../components/AdminNav.astro';
import '../../styles/global.css';
---

<BaseLayout title="Users & Trial Deployments — ZoomPhant Admin">
  <Header currentPath={Astro.url.pathname} />
  <AdminNav activeTab="users" />

  <main class="min-h-screen bg-gray-50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- Top Title Bar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-extrabold text-gray-900 tracking-tight">Customer Deployments & User Directory</h2>
          <p class="text-xs text-gray-500 mt-0.5">Audit customer BYOC clusters provisioned on Cloudflare and browse user accounts.</p>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Deployments</span>
          <div id="statTotalDeployments" class="text-3xl font-extrabold text-gray-900 mt-2">—</div>
          <span class="text-xs text-brand-600 font-medium mt-1 inline-block">Cloudflare clusters</span>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Healthy Clusters</span>
          <div id="statSuccessDeployments" class="text-3xl font-extrabold text-emerald-600 mt-2">—</div>
          <span class="text-xs text-emerald-600 font-medium mt-1 inline-flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Live on Cloudflare
          </span>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Signed-Up Users</span>
          <div id="statTotalUsers" class="text-3xl font-extrabold text-gray-900 mt-2">—</div>
          <span class="text-xs text-gray-500 font-medium mt-1 inline-block">Credentials & OAuth</span>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Business Registrations</span>
          <div id="statTotalRegistrations" class="text-3xl font-extrabold text-gray-900 mt-2">—</div>
          <span class="text-xs text-gray-500 font-medium mt-1 inline-block">Community tier licenses</span>
        </div>
      </div>

      <!-- Main Tabbed Directory Card -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
        
        <!-- Tab Bar Header -->
        <div class="px-6 pt-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex space-x-6 overflow-x-auto" id="userTabsHeader">
            <button
              type="button"
              id="tabBtnDeployments"
              class="pb-4 px-1 border-b-2 border-brand-600 text-brand-600 font-bold text-sm flex items-center gap-2 cursor-pointer transition-colors"
            >
              <span>🚀 Trial Deployments</span>
              <span id="badgeDeployments" class="rounded-full bg-brand-50 px-2 py-0.5 text-xs text-brand-700">0</span>
            </button>

            <button
              type="button"
              id="tabBtnUsers"
              class="pb-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium text-sm flex items-center gap-2 cursor-pointer transition-colors"
            >
              <span>👥 Platform Users</span>
              <span id="badgeUsers" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">0</span>
            </button>

            <button
              type="button"
              id="tabBtnRegistrations"
              class="pb-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium text-sm flex items-center gap-2 cursor-pointer transition-colors"
            >
              <span>🏢 Business Licenses</span>
              <span id="badgeRegistrations" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">0</span>
            </button>
          </div>

          <!-- Quick Filters (Dynamic per active tab) -->
          <div id="deploymentsFilterContainer" class="flex items-center gap-2 pb-4 sm:pb-3">
            <label for="statusFilter" class="text-xs text-gray-400">Status:</label>
            <select id="statusFilter" class="rounded-xl border border-gray-300 bg-white px-3 py-1.5 text-xs text-gray-700 shadow-sm focus:outline-none">
              <option value="all">All Deployments</option>
              <option value="success">Success Only</option>
              <option value="failed">Failed Only</option>
              <option value="in_progress">In Progress</option>
            </select>
          </div>
        </div>

        <!-- Tab Panel 1: Customer Trial Deployments -->
        <div id="panelDeployments" class="block">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3.5">Deployment ID / Time</th>
                  <th class="px-6 py-3.5">User Account</th>
                  <th class="px-6 py-3.5">Worker URL</th>
                  <th class="px-6 py-3.5">Cloudflare Account ID</th>
                  <th class="px-6 py-3.5">Version</th>
                  <th class="px-6 py-3.5">Status</th>
                  <th class="px-6 py-3.5">Diagnostics</th>
                </tr>
              </thead>
              <tbody id="deploymentsTableBody" class="divide-y divide-gray-100 text-xs font-mono">
                <tr>
                  <td colspan="7" class="px-6 py-8 text-center text-gray-400 font-sans">
                    Loading deployment records...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Panel 2: Registered Platform Users -->
        <div id="panelUsers" class="hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3.5">User ID</th>
                  <th class="px-6 py-3.5">Name</th>
                  <th class="px-6 py-3.5">Email</th>
                  <th class="px-6 py-3.5">Role</th>
                  <th class="px-6 py-3.5">Organization / Metadata</th>
                  <th class="px-6 py-3.5">Created Date</th>
                </tr>
              </thead>
              <tbody id="usersTableBody" class="divide-y divide-gray-100 text-xs">
                <tr>
                  <td colspan="6" class="px-6 py-8 text-center text-gray-400 font-sans">
                    Loading registered users...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Panel 3: Community Business Registrations -->
        <div id="panelRegistrations" class="hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3.5">Company</th>
                  <th class="px-6 py-3.5">Contact Email</th>
                  <th class="px-6 py-3.5">Company Size</th>
                  <th class="px-6 py-3.5">Infrastructure</th>
                  <th class="px-6 py-3.5">Website</th>
                  <th class="px-6 py-3.5">Registration Date</th>
                </tr>
              </thead>
              <tbody id="regTableBody" class="divide-y divide-gray-100 text-xs">
                <tr>
                  <td colspan="6" class="px-6 py-8 text-center text-gray-400 font-sans">
                    Loading business registrations...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />

  <script>
    import { apiClient } from '../../utils/apiClient';

    // 1. Guard route: Verify Admin Authentication
    const token = localStorage.getItem('zp_token');
    const userStr = localStorage.getItem('zp_user');
    let user = null;

    try {
      if (userStr) user = JSON.parse(userStr);
    } catch {}

    if (!token || user?.role !== 'admin') {
      window.location.href = '/login/?redirect=/admin/users/';
    }

    // Tab buttons & panels
    const tabBtnDeployments = document.getElementById('tabBtnDeployments');
    const tabBtnUsers = document.getElementById('tabBtnUsers');
    const tabBtnRegistrations = document.getElementById('tabBtnRegistrations');

    const panelDeployments = document.getElementById('panelDeployments');
    const panelUsers = document.getElementById('panelUsers');
    const panelRegistrations = document.getElementById('panelRegistrations');
    const deploymentsFilterContainer = document.getElementById('deploymentsFilterContainer');

    const badgeDeployments = document.getElementById('badgeDeployments');
    const badgeUsers = document.getElementById('badgeUsers');
    const badgeRegistrations = document.getElementById('badgeRegistrations');

    const statTotalDeployments = document.getElementById('statTotalDeployments');
    const statSuccessDeployments = document.getElementById('statSuccessDeployments');
    const statTotalUsers = document.getElementById('statTotalUsers');
    const statTotalRegistrations = document.getElementById('statTotalRegistrations');

    const deploymentsTableBody = document.getElementById('deploymentsTableBody');
    const usersTableBody = document.getElementById('usersTableBody');
    const regTableBody = document.getElementById('regTableBody');
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;

    let allDeployments: any[] = [];
    let allUsers: any[] = [];
    let allRegistrations: any[] = [];

    // Tab switching logic
    function switchTab(activeTab: 'deployments' | 'users' | 'registrations') {
      const activeClasses = ['border-brand-600', 'text-brand-600', 'font-bold'];
      const inactiveClasses = ['border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300'];

      // Reset all buttons
      [tabBtnDeployments, tabBtnUsers, tabBtnRegistrations].forEach((btn) => {
        btn?.classList.remove(...activeClasses);
        btn?.classList.add(...inactiveClasses);
      });

      // Hide all panels
      panelDeployments?.classList.add('hidden');
      panelUsers?.classList.add('hidden');
      panelRegistrations?.classList.add('hidden');
      deploymentsFilterContainer?.classList.add('hidden');

      if (activeTab === 'deployments') {
        tabBtnDeployments?.classList.add(...activeClasses);
        tabBtnDeployments?.classList.remove(...inactiveClasses);
        panelDeployments?.classList.remove('hidden');
        deploymentsFilterContainer?.classList.remove('hidden');
      } else if (activeTab === 'users') {
        tabBtnUsers?.classList.add(...activeClasses);
        tabBtnUsers?.classList.remove(...inactiveClasses);
        panelUsers?.classList.remove('hidden');
      } else {
        tabBtnRegistrations?.classList.add(...activeClasses);
        tabBtnRegistrations?.classList.remove(...inactiveClasses);
        panelRegistrations?.classList.remove('hidden');
      }
    }

    tabBtnDeployments?.addEventListener('click', () => switchTab('deployments'));
    tabBtnUsers?.addEventListener('click', () => switchTab('users'));
    tabBtnRegistrations?.addEventListener('click', () => switchTab('registrations'));

    async function loadData() {
      try {
        const [depData, usersData] = await Promise.all([
          apiClient('/api/admin/deployments', { token }),
          apiClient('/api/admin/users', { token }),
        ]);

        allDeployments = depData.deployments || [];
        allUsers = usersData.users || [];
        allRegistrations = usersData.registrations || [];

        // Render summary metrics
        if (statTotalDeployments) statTotalDeployments.textContent = allDeployments.length.toString();
        const successCount = allDeployments.filter((d: any) => d.status === 'success').length;
        if (statSuccessDeployments) statSuccessDeployments.textContent = successCount.toString();
        if (statTotalUsers) statTotalUsers.textContent = allUsers.length.toString();
        if (statTotalRegistrations) statTotalRegistrations.textContent = allRegistrations.length.toString();

        if (badgeDeployments) badgeDeployments.textContent = allDeployments.length.toString();
        if (badgeUsers) badgeUsers.textContent = allUsers.length.toString();
        if (badgeRegistrations) badgeRegistrations.textContent = allRegistrations.length.toString();

        renderDeployments();
        renderUsers();
        renderRegistrations();

      } catch (err: any) {
        console.error('Failed to load data:', err);
      }
    }

    function renderDeployments() {
      if (!deploymentsTableBody) return;
      const filter = statusFilter?.value || 'all';

      const filtered = allDeployments.filter((d: any) => {
        if (filter === 'all') return true;
        return d.status === filter;
      });

      if (filtered.length === 0) {
        deploymentsTableBody.innerHTML = `
          <tr>
            <td colspan="7" class="px-6 py-8 text-center text-gray-400 font-sans">
              No deployments matching "${filter}".
            </td>
          </tr>
        `;
        return;
      }

      deploymentsTableBody.innerHTML = filtered.map((d: any) => {
        const dateStr = new Date(d.created_at).toLocaleString();
        const userDisplay = d.user_email
          ? `<span class="font-sans font-semibold text-gray-900">${d.user_email}</span>`
          : d.user_id && d.user_id !== 'guest_trial_user'
          ? `<span class="text-gray-600">${d.user_id}</span>`
          : `<span class="font-sans text-gray-400 italic">Guest User</span>`;

        const statusBadge = d.status === 'success'
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20 font-sans"><span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Live</span>`
          : d.status === 'failed'
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20 font-sans"><span class="h-1.5 w-1.5 rounded-full bg-red-600"></span> Failed</span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20 font-sans">In Progress</span>`;

        return `
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="font-bold text-gray-900">${d.id}</span><br/>
              <span class="text-[11px] text-gray-400 font-sans">${dateStr}</span>
            </td>
            <td class="px-6 py-4">
              ${userDisplay}
            </td>
            <td class="px-6 py-4">
              ${d.worker_url
                ? `<a href="${d.worker_url}" target="_blank" class="text-brand-600 hover:text-brand-800 underline truncate block max-w-xs">${d.worker_url}</a>`
                : `<span class="text-gray-400 font-sans italic">—</span>`
              }
            </td>
            <td class="px-6 py-4 text-gray-500 font-mono">
              ${d.cf_account_id}
            </td>
            <td class="px-6 py-4 font-bold text-gray-700">
              v${d.release_version}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              ${statusBadge}
            </td>
            <td class="px-6 py-4 font-sans text-xs max-w-xs truncate" title="${d.error_message || ''}">
              ${d.error_message
                ? `<span class="text-red-600 font-medium">${d.error_message}</span>`
                : `<span class="text-emerald-600 font-medium">Provisioned OK</span>`
              }
            </td>
          </tr>
        `;
      }).join('');
    }

    function renderUsers() {
      if (!usersTableBody) return;

      if (allUsers.length === 0) {
        usersTableBody.innerHTML = `
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-400">
              No registered platform users found.
            </td>
          </tr>
        `;
        return;
      }

      usersTableBody.innerHTML = allUsers.map((u: any) => {
        let metaCompany = '—';
        try {
          if (u.metadata) {
            const parsed = typeof u.metadata === 'string' ? JSON.parse(u.metadata) : u.metadata;
            if (parsed.company) metaCompany = parsed.company;
          }
        } catch {}

        return `
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="px-6 py-4 font-mono text-gray-500">${u.id}</td>
            <td class="px-6 py-4 font-semibold text-gray-900">${u.name}</td>
            <td class="px-6 py-4 text-gray-600">${u.email}</td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                u.role === 'admin' ? 'bg-purple-50 text-purple-700 border border-purple-200' : 'bg-gray-100 text-gray-700'
              }">
                ${u.role}
              </span>
            </td>
            <td class="px-6 py-4 text-gray-500">${metaCompany}</td>
            <td class="px-6 py-4 text-gray-400 whitespace-nowrap">${new Date(u.createdAt).toLocaleDateString()}</td>
          </tr>
        `;
      }).join('');
    }

    function renderRegistrations() {
      if (!regTableBody) return;

      if (allRegistrations.length === 0) {
        regTableBody.innerHTML = `
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-400">
              No business registrations found.
            </td>
          </tr>
        `;
        return;
      }

      regTableBody.innerHTML = allRegistrations.map((r: any) => `
        <tr class="hover:bg-gray-50/50 transition-colors">
          <td class="px-6 py-4 font-semibold text-gray-900">${r.company}</td>
          <td class="px-6 py-4 text-gray-600">${r.email}</td>
          <td class="px-6 py-4 text-gray-500">${r.company_size || '—'}</td>
          <td class="px-6 py-4 text-gray-500 capitalize">${r.infrastructure || '—'}</td>
          <td class="px-6 py-4">
            ${r.website
              ? `<a href="${r.website}" target="_blank" class="text-brand-600 hover:text-brand-700 underline truncate block max-w-xs">${r.website}</a>`
              : '—'
            }
          </td>
          <td class="px-6 py-4 text-gray-400 whitespace-nowrap">${new Date(r.created_at).toLocaleDateString()}</td>
        </tr>
      `).join('');
    }

    statusFilter?.addEventListener('change', renderDeployments);

    // Initial load
    loadData();
  </script>
</BaseLayout>
