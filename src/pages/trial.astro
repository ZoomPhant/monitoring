---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Self-Service Trial — Deploy ZoomPhant TSDB on Cloudflare">
  <Header currentPath={Astro.url.pathname} />

  <main class="min-h-screen bg-gray-50/50 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      
      <!-- Top Header / Value Prop -->
      <div class="text-center mb-10">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3.5 py-1 text-xs font-semibold text-brand-700 ring-1 ring-inset ring-brand-700/10">
          <svg class="h-1.5 w-1.5 fill-brand-500" viewBox="0 0 6 6" aria-hidden="true">
            <circle cx="3" cy="3" r="3" />
          </svg>
          Bring Your Own Cloud (BYOC)
        </span>
        <h1 class="mt-4 text-4xl font-extrabold text-gray-900 tracking-tight sm:text-5xl">
          Launch TSDB on Your Cloudflare
        </h1>
        <p class="mt-3 text-base text-gray-600 max-w-xl mx-auto">
          Deploy a complete, production-grade TSDB cluster (Durable Objects, R2, and Portal UI) into your own Cloudflare account in under 60 seconds.
        </p>
      </div>

      <!-- Main Wizard Card -->
      <div class="bg-white rounded-3xl border border-gray-200/80 shadow-xl shadow-gray-100/50 overflow-hidden">
        
        <!-- Form View -->
        <div id="formSection" class="p-8 sm:p-10">

          <!-- Connected Banner -->
          <div id="cfConnectedNotice" class="hidden mb-6 rounded-2xl bg-emerald-50 p-4 border border-emerald-200">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <h4 class="text-sm font-semibold text-emerald-900">Cloudflare Account Connected!</h4>
                <p class="text-xs text-emerald-700 mt-0.5">
                  Your Account ID and deploy credentials have been auto-configured below. Click <strong>Deploy TSDB into My Account</strong> to finish provisioning!
                </p>
              </div>
            </div>
          </div>

          <!-- Fallback Notice Banner -->
          <div id="cfFallbackNotice" class="hidden mb-6 rounded-2xl bg-amber-50 p-4 border border-amber-200">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <h4 class="text-sm font-semibold text-amber-900">Cloudflare 1-Click Connect Early Access</h4>
                <p class="text-xs text-amber-700 mt-0.5">
                  1-Click OAuth app is undergoing verification. You can deploy instantly by entering your Cloudflare credentials manually below!
                </p>
              </div>
            </div>
          </div>

          <!-- Option 1: 1-Click Connect with Cloudflare -->
          <div class="rounded-2xl border-2 border-orange-100 bg-gradient-to-br from-orange-50/60 via-amber-50/30 to-white p-5 sm:p-6 mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div class="space-y-1.5">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-orange-100 text-[#F6821F] text-xs font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#F6821F] animate-pulse"></span>
                  RECOMMENDED • 1-CLICK SETUP
                </div>
                <h3 class="text-base font-bold text-gray-900">
                  Connect with Cloudflare
                </h3>
                <p class="text-xs text-gray-600 max-w-md">
                  Authorize directly with Cloudflare to auto-detect your Account ID and configure permissions automatically. No manual copying or API token creation needed.
                </p>
              </div>
              <div class="shrink-0">
                <a
                  id="cfOAuthBtn"
                  href="#"
                  class="inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl bg-[#F6821F] hover:bg-[#e27315] text-white font-semibold text-sm shadow-md shadow-orange-500/20 transition-all hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
                >
                  <!-- Cloudflare Cloud SVG -->
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z"/>
                  </svg>
                  <span>Connect with Cloudflare</span>
                </a>
              </div>
            </div>
            
            <div class="mt-4 pt-3 border-t border-orange-100/80 flex flex-wrap gap-y-1 gap-x-4 text-[11px] text-gray-500">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                Auto-discovers Account ID
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                Scoped Workers & Storage access
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                100% Hosted in your account
              </span>
            </div>
          </div>

          <!-- Divider -->
          <div class="relative my-8">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="w-full border-t border-gray-200"></div>
            </div>
            <div class="relative flex justify-center text-xs font-semibold uppercase tracking-wider">
              <span class="bg-white px-4 text-gray-400">or enter cloudflare credentials manually</span>
            </div>
          </div>

          <!-- Option 2: Manual Credentials Form -->
          <form id="deployForm" class="space-y-6">
            
            <!-- Step 1: Cloudflare Account ID -->
            <div>
              <div class="flex items-center justify-between">
                <label for="accountId" class="block text-sm font-semibold text-gray-900">
                  1. Cloudflare Account ID
                </label>
                <span class="text-xs text-gray-500">32-character hex ID</span>
              </div>
              <p class="text-xs text-gray-500 mt-0.5 mb-2">
                Found on the right sidebar of your Cloudflare <strong>Workers & Pages</strong> dashboard overview.
              </p>
              <input
                type="text"
                id="accountId"
                name="accountId"
                required
                placeholder="e.g. 457d7f2f5113f6a89dd35d6b28d24835"
                class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 font-mono shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none transition-all"
              />
            </div>

            <!-- Step 2: Cloudflare API Token -->
            <div>
              <div class="flex items-center justify-between">
                <label for="apiToken" class="block text-sm font-semibold text-gray-900">
                  2. Cloudflare API Token
                </label>
                <a
                  href="https://dash.cloudflare.com/profile/api-tokens?template=edit-cloudflare-workers"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-700"
                >
                  Create Token (1-Click Template) →
                </a>
              </div>
              <p class="text-xs text-gray-500 mt-0.5 mb-2">
                Needs <strong>Workers Scripts: Edit</strong>, <strong>Workers KV: Edit</strong>, and <strong>Workers R2: Edit</strong>. Tokens are used in-memory only and never saved.
              </p>
              <input
                type="password"
                id="apiToken"
                name="apiToken"
                required
                placeholder="Cloudflare API Bearer Token"
                class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 font-mono shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none transition-all"
              />
            </div>

            <!-- Step 3: Admin Password / Token -->
            <div>
              <label for="adminPassword" class="block text-sm font-semibold text-gray-900">
                3. Super-Admin Token
              </label>
              <p class="text-xs text-gray-500 mt-0.5 mb-2">
                Bearer token used to authenticate to your TSDB Portal UI and ingest APIs.
              </p>
              <div class="relative">
                <input
                  type="text"
                  id="adminPassword"
                  name="adminPassword"
                  value=""
                  placeholder="Generating secure token..."
                  class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 font-mono shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none transition-all"
                />
              </div>
            </div>

            <!-- Step 4: Data Retention Policy -->
            <div>
              <div class="flex items-center justify-between">
                <label for="retentionDays" class="block text-sm font-semibold text-gray-900">
                  4. Data Retention Policy
                </label>
                <span class="text-xs font-sans text-gray-400">Cloudflare R2 Lifecycle</span>
              </div>
              <p class="text-xs text-gray-500 mt-0.5 mb-2">
                Data older than this in your R2 bucket will automatically expire without extra storage cost.
              </p>
              <select
                id="retentionDays"
                name="retentionDays"
                class="w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 font-medium shadow-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none transition-all cursor-pointer"
              >
                <option value="90">3 Months (90 days) - Minimal Storage</option>
                <option value="180">6 Months (180 days) - Standard Metrics</option>
                <option value="365" selected>1 Year (365 days) - Recommended Default</option>
                <option value="1095">3 Years (1,095 days) - Extended Compliance</option>
                <option value="3650">10 Years (3,650 days) - Long-term Archive</option>
              </select>
            </div>

            <!-- Error Banner -->
            <div id="errorBanner" class="hidden rounded-xl bg-red-50 p-4 border border-red-200 text-sm text-red-700">
              <span id="errorMessage"></span>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="submitBtn"
              class="w-full rounded-xl bg-brand-600 px-6 py-4 text-base font-semibold text-white shadow-lg shadow-brand-500/25 hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:ring-offset-2 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              Deploy TSDB into My Account
            </button>

            <!-- Guarantees -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-center text-xs text-gray-500">
              <div class="flex items-center justify-center gap-1.5">
                <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Zero local setup
              </div>
              <div class="flex items-center justify-center gap-1.5">
                <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                100% Data Sovereignty
              </div>
              <div class="flex items-center justify-center gap-1.5">
                <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Tokens never stored
              </div>
            </div>

          </form>
        </div>

        <!-- Progress / Deploying View (Hidden by default) -->
        <div id="progressSection" class="hidden p-10 sm:p-14 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-brand-50 text-brand-600 mb-6">
            <svg class="animate-spin h-8 w-8" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900">Provisioning Your TSDB Cluster...</h3>
          <p class="mt-2 text-sm text-gray-500 max-w-sm mx-auto">
            Please keep this tab open while Cloudflare provisions your storage, KV caches, and Durable Objects.
          </p>

          <div class="mt-8 max-w-md mx-auto space-y-3 text-left">
            <div id="step1" class="flex items-center gap-3 text-sm text-brand-600 font-medium">
              <span class="step-icon">⏳</span> Validating credentials & Workers Paid plan...
            </div>
            <div id="step2" class="flex items-center gap-3 text-sm text-gray-400">
              <span class="step-icon">○</span> Provisioning R2 bucket (tsdb-blocks) & KV cache...
            </div>
            <div id="step3" class="flex items-center gap-3 text-sm text-gray-400">
              <span class="step-icon">○</span> Uploading TSDB engine & React Portal assets...
            </div>
            <div id="step4" class="flex items-center gap-3 text-sm text-gray-400">
              <span class="step-icon">○</span> Setting up security secrets & live routing...
            </div>
          </div>
        </div>

        <!-- Success View (Hidden by default) -->
        <div id="successSection" class="hidden p-8 sm:p-12 text-center bg-gradient-to-b from-white to-emerald-50/30">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mb-6">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 class="text-3xl font-extrabold text-gray-900">Deployment Complete!</h2>
          <p class="mt-2 text-base text-gray-600">Your TSDB instance is live on Cloudflare's edge network.</p>

          <!-- Live Endpoint Card -->
          <div class="mt-8 p-6 bg-white rounded-2xl border border-gray-200 shadow-sm text-left">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Live Worker URL</span>
            <div class="mt-1 flex items-center justify-between">
              <a id="liveUrlLink" href="#" target="_blank" class="text-base sm:text-lg font-bold text-brand-600 hover:text-brand-700 underline truncate"></a>
              <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700">Healthy</span>
            </div>

            <div class="mt-6 pt-6 border-t border-gray-100">
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Quick Ingestion Test</span>
              <p class="text-xs text-gray-500 mt-1 mb-2">Run this command in your terminal to ingest your first test metric:</p>
              <pre id="curlBox" class="p-3 bg-gray-900 text-gray-100 rounded-xl text-xs overflow-x-auto font-mono select-all"></pre>
            </div>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
            <a
              id="openPortalBtn"
              href="#"
              target="_blank"
              class="rounded-xl bg-brand-600 px-6 py-3.5 text-sm font-semibold text-white shadow-md hover:bg-brand-700 transition-all text-center"
            >
              Open TSDB Portal →
            </a>
            <a
              href="/docs/quickstart/"
              class="rounded-xl border border-gray-300 bg-white px-6 py-3.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-all text-center"
            >
              Read Quickstart Guide
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />

  <script>
    import { apiClient, getOAuthUrl } from '../utils/apiClient';

    // Set OAuth Link for Cloudflare 1-Click Connect
    const cfOAuthBtn = document.getElementById('cfOAuthBtn') as HTMLAnchorElement;
    if (cfOAuthBtn) {
      cfOAuthBtn.href = getOAuthUrl('cloudflare');
    }

    // Auto-generate random secure admin token if empty
    const adminInput = document.getElementById('adminPassword') as HTMLInputElement;
    if (adminInput && !adminInput.value) {
      const randomHex = Array.from(crypto.getRandomValues(new Uint8Array(16)))
        .map(b => b.toString(16).padStart(2, '0'))
        .join('');
      adminInput.value = `tsdb_admin_${randomHex}`;
    }

    // Check for incoming OAuth parameters or fallback notices
    const urlParams = new URLSearchParams(window.location.search);
    const cfConnected = urlParams.get('cf_connected');
    const cfNotice = urlParams.get('cf_notice');
    const accountIdParam = urlParams.get('account_id');
    const tokenParam = urlParams.get('cf_token');

    const accountInput = document.getElementById('accountId') as HTMLInputElement;
    const tokenInput = document.getElementById('apiToken') as HTMLInputElement;
    const cfConnectedNotice = document.getElementById('cfConnectedNotice');
    const cfFallbackNotice = document.getElementById('cfFallbackNotice');

    if (cfConnected === '1') {
      if (accountIdParam && accountInput) accountInput.value = accountIdParam;
      if (tokenParam && tokenInput) tokenInput.value = tokenParam;
      cfConnectedNotice?.classList.remove('hidden');
    } else if (cfNotice === 'oauth_unconfigured') {
      cfFallbackNotice?.classList.remove('hidden');
      accountInput?.focus();
    }

    const form = document.getElementById('deployForm');
    const formSection = document.getElementById('formSection');
    const progressSection = document.getElementById('progressSection');
    const successSection = document.getElementById('successSection');
    const errorBanner = document.getElementById('errorBanner');
    const errorMessage = document.getElementById('errorMessage');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBanner?.classList.add('hidden');

      const accountId = (document.getElementById('accountId') as HTMLInputElement).value.trim();
      const apiToken = (document.getElementById('apiToken') as HTMLInputElement).value.trim();
      const adminPassword = (document.getElementById('adminPassword') as HTMLInputElement).value.trim();
      const retentionDays = parseInt((document.getElementById('retentionDays') as HTMLSelectElement)?.value || '365', 10);

      // Show Progress View
      formSection?.classList.add('hidden');
      progressSection?.classList.remove('hidden');

      const s1 = document.getElementById('step1');
      const s2 = document.getElementById('step2');
      const s3 = document.getElementById('step3');
      const s4 = document.getElementById('step4');

      // Animate progress indicators
      const timer1 = setTimeout(() => {
        if (s1 && s2) {
          s1.innerHTML = '<span>✅</span> Credentials & Workers plan verified';
          s1.className = 'flex items-center gap-3 text-sm text-emerald-600 font-medium';
          s2.innerHTML = '<span class="step-icon">⏳</span> Provisioning R2 bucket & lifecycle policy...';
          s2.className = 'flex items-center gap-3 text-sm text-brand-600 font-medium';
        }
      }, 3500);

      const timer2 = setTimeout(() => {
        if (s2 && s3) {
          s2.innerHTML = '<span>✅</span> R2 bucket & lifecycle policy provisioned';
          s2.className = 'flex items-center gap-3 text-sm text-emerald-600 font-medium';
          s3.innerHTML = '<span class="step-icon">⏳</span> Uploading TSDB engine & React Portal assets...';
          s3.className = 'flex items-center gap-3 text-sm text-brand-600 font-medium';
        }
      }, 9000);

      try {
        const data = await apiClient('/api/deploy-trial', {
          method: 'POST',
          body: JSON.stringify({ accountId, apiToken, adminPassword, retentionDays }),
        });

        clearTimeout(timer1);
        clearTimeout(timer2);

        // Show Success View
        progressSection?.classList.add('hidden');
        successSection?.classList.remove('hidden');

        const liveUrl = data.liveUrl;
        const liveUrlLink = document.getElementById('liveUrlLink') as HTMLAnchorElement;
        const openPortalBtn = document.getElementById('openPortalBtn') as HTMLAnchorElement;
        const curlBox = document.getElementById('curlBox');

        if (liveUrlLink) {
          liveUrlLink.href = liveUrl;
          liveUrlLink.textContent = liveUrl;
        }
        if (openPortalBtn) {
          openPortalBtn.href = liveUrl;
        }
        if (curlBox) {
          curlBox.textContent = data.curlSample;
        }

      } catch (err: any) {
        clearTimeout(timer1);
        clearTimeout(timer2);
        progressSection?.classList.add('hidden');
        formSection?.classList.remove('hidden');
        if (errorBanner && errorMessage) {
          errorMessage.textContent = err.message || 'An error occurred during deployment.';
          errorBanner.classList.remove('hidden');
        }
      }
    });
  </script>
</BaseLayout>

