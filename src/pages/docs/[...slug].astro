---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { entry: doc },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allDocs = await getCollection('docs');

function buildSidebar(docs: { slug: string; data: { title: string; parent?: string; grand_parent?: string; nav_order?: number } }[]) {
  const pages = docs.map((d) => ({
    slug: d.slug,
    title: d.data.title,
    parent: d.data.parent,
    grand_parent: d.data.grand_parent,
    nav_order: d.data.nav_order ?? 99,
  }));

  const topLevel = pages
    .filter((p) => !p.parent)
    .sort((a, b) => a.nav_order - b.nav_order);

  // Include virtual 'About' top-level group for pages with parent: 'About'
  const aboutPages = pages
    .filter((p) => p.parent === 'About')
    .sort((a, b) => a.nav_order - b.nav_order);

  const sections = topLevel.map((section) => {
    const children = pages
      .filter((p) => p.parent === section.title && !p.grand_parent)
      .sort((a, b) => a.nav_order - b.nav_order);

    const grandchildren = pages.filter((p) => p.grand_parent === section.title);
    const childrenWithGrandchildren = children.map((child) => {
      const subChildren = grandchildren
        .filter((gc) => gc.parent === child.title)
        .sort((a, b) => a.nav_order - b.nav_order);
      return {
        title: child.title,
        href: `/docs/${child.slug}/`,
        children: subChildren.length > 0
          ? subChildren.map((sc) => ({
              title: sc.title,
              href: `/docs/${sc.slug}/`,
            }))
          : undefined,
      };
    });

    return {
      title: section.title,
      href: `/docs/${section.slug}/`,
      children: childrenWithGrandchildren.length > 0 ? childrenWithGrandchildren : undefined,
    };
  });

  if (aboutPages.length > 0) {
    sections.push({
      title: 'About',
      href: `/docs/${aboutPages[0].slug}/`,
      children: aboutPages.map((p) => ({
        title: p.title,
        href: `/docs/${p.slug}/`,
        children: undefined,
      })),
    });
  }

  return sections;
}

const sidebar = buildSidebar(allDocs);

// Extract a clean, unique meta description from the Markdown body when frontmatter omits `description`
function extractDescription(rawBody: string | undefined, fallbackTitle: string): string {
  if (!rawBody) return `Documentation for ${fallbackTitle} in ZoomPhant Monitoring & TSDB.`;
  const cleaned = rawBody
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+.*$/gm, ' ')
    .replace(/^[-*>|]+\s*/gm, ' ')
    .replace(/[*_`~]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (!cleaned) return `Step-by-step guide for ${fallbackTitle} in ZoomPhant.`;
  return cleaned.length > 158 ? `${cleaned.slice(0, 155).trimEnd()}…` : cleaned;
}

const seoTitle = entry.data.parent && entry.data.title.length < 28
  ? `${entry.data.title} (${entry.data.parent})`
  : entry.data.title;
const seoDescription = entry.data.description || extractDescription(entry.body, entry.data.title);
const pageUrl = `https://www.zoomphant.com/docs/${entry.slug}/`;

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.zoomphant.com/' },
  { '@type': 'ListItem', position: 2, name: 'Docs', item: 'https://www.zoomphant.com/docs/' },
  ...(entry.data.parent
    ? [{ '@type': 'ListItem', position: 3, name: entry.data.parent, item: 'https://www.zoomphant.com/docs/manual/' }]
    : []),
  {
    '@type': 'ListItem',
    position: entry.data.parent ? 4 : 3,
    name: entry.data.title,
    item: pageUrl,
  },
];

const docJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: seoTitle,
    description: seoDescription,
    url: pageUrl,
    publisher: {
      '@type': 'Organization',
      name: 'ZoomPhant',
      url: 'https://www.zoomphant.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  },
];
---

<DocsLayout title={seoTitle} description={seoDescription} jsonLd={docJsonLd} sidebar={sidebar} currentPath={Astro.url.pathname}>
  <Content />
</DocsLayout>
