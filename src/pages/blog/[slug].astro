---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { categoryBadgeClass, categorySlug, formatBlogDate } from '../../utils/blog';

export async function getStaticPaths() {
  let posts: Awaited<ReturnType<typeof getCollection<'blog'>>> = [];
  try {
    posts = (await getCollection('blog')).sort(
      (a, b) => b.data.date.getTime() - a.data.date.getTime()
    );
  } catch {
    posts = [];
  }
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      related: posts.filter((p) => p.slug !== post.slug).slice(0, 2),
    },
  }));
}

const { post, related } = Astro.props;
const { Content } = await post.render();
const catSlug = categorySlug(post.data.category);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Organization',
    name: post.data.author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'ZoomPhant',
    url: 'https://www.zoomphant.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://www.zoomphant.com/logo.svg',
    },
  },
  mainEntityOfPage: `https://www.zoomphant.com/blog/${post.slug}/`,
};
---

<BaseLayout
  title={`${post.data.title} — ZoomPhant Blog`}
  description={post.data.description}
  keywords={post.data.tags.join(', ')}
  ogImage={post.data.coverImage}
  jsonLd={articleJsonLd}
>
  <Header currentPath={Astro.url.pathname} />

  <main class="bg-white">
    <!-- Article Header -->
    <header class="border-b border-gray-100 bg-gradient-to-b from-brand-50/50 via-white to-white pt-12 pb-10 sm:pt-16 sm:pb-12">
      <div class="mx-auto max-w-3xl px-6">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs font-medium text-gray-500" aria-label="Breadcrumb">
          <a href="/blog/" class="hover:text-brand-600 transition-colors">Blog</a>
          <span>/</span>
          <a href={`/blog/?category=${catSlug}`} class="hover:text-brand-600 transition-colors">
            {post.data.category}
          </a>
        </nav>

        <div class="mt-5 flex flex-wrap items-center gap-2.5 text-xs">
          <a
            href={`/blog/?category=${catSlug}`}
            class:list={['inline-flex items-center rounded-full border px-3 py-0.5 font-bold', categoryBadgeClass(post.data.category)]}
          >
            {post.data.category}
          </a>
          <time datetime={post.data.date.toISOString()} class="text-gray-500 font-medium">
            {formatBlogDate(post.data.date)}
          </time>
          {post.data.readingTime && (
            <>
              <span class="text-gray-300">·</span>
              <span class="text-gray-500">{post.data.readingTime}</span>
            </>
          )}
        </div>

        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl lg:leading-[1.15]">
          {post.data.title}
        </h1>

        {post.data.subtitle && (
          <p class="mt-4 text-lg leading-relaxed text-gray-600">
            {post.data.subtitle}
          </p>
        )}

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-gray-100">
          <div class="flex items-center gap-3">
            <img src="/logo.svg" alt={post.data.author} class="h-9 w-9 rounded-full border border-gray-200 bg-white p-1" />
            <div>
              <p class="text-sm font-bold text-gray-900">{post.data.author}</p>
              {post.data.authorRole && <p class="text-xs text-gray-500">{post.data.authorRole}</p>}
            </div>
          </div>

          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="rounded-lg bg-gray-100 px-2.5 py-0.5 text-[11px] font-medium text-gray-600">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Article Body -->
    <article class="mx-auto max-w-3xl px-6 py-12 sm:py-16">
      <div class="prose prose-slate prose-lg max-w-none prose-headings:font-extrabold prose-headings:tracking-tight prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-img:rounded-2xl prose-img:border prose-img:border-gray-200 prose-img:shadow-sm prose-code:before:content-none prose-code:after:content-none prose-code:rounded prose-code:bg-slate-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:text-[0.85em] prose-code:font-medium prose-pre:rounded-2xl prose-pre:border prose-pre:border-slate-800 prose-pre:bg-slate-950 prose-table:text-sm">
        <Content />
      </div>

      <!-- Bottom CTA -->
      <div class="mt-14 rounded-3xl bg-gradient-to-br from-gray-900 via-slate-900 to-brand-950 p-7 sm:p-9 text-white border border-gray-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <span class="inline-flex rounded-full bg-brand-500/20 border border-brand-400/30 px-3 py-0.5 text-[11px] font-bold text-brand-300">
            First Instance Free
          </span>
          <h2 class="mt-3 text-xl font-extrabold text-white">
            Give your coding agent its own TSDB
          </h2>
          <p class="mt-1.5 text-sm text-gray-300 max-w-md">
            Deploy in 60 seconds in your own cloud account, mint a scoped read-only token, and let your agents query live telemetry directly.
          </p>
        </div>
        <a
          href="/dashboard/"
          class="shrink-0 inline-flex items-center justify-center rounded-xl bg-brand-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-brand-500/25 hover:bg-brand-500 transition-colors whitespace-nowrap"
        >
          Launch Free TSDB →
        </a>
      </div>

      <!-- Related Posts -->
      {related.length > 0 && (
        <section class="mt-14 pt-10 border-t border-gray-100">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-extrabold text-gray-900">More from the Blog</h2>
            <a href="/blog/" class="text-xs font-bold text-brand-600 hover:underline">View all posts →</a>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            {related.map((r) => (
              <a
                href={`/blog/${r.slug}/`}
                class="group rounded-2xl border border-gray-200 p-5 hover:border-brand-300 hover:shadow-sm transition-all"
              >
                <span class:list={['inline-flex rounded-full border px-2.5 py-0.5 text-[11px] font-bold', categoryBadgeClass(r.data.category)]}>
                  {r.data.category}
                </span>
                <h3 class="mt-3 text-base font-bold text-gray-900 group-hover:text-brand-700 transition-colors">
                  {r.data.title}
                </h3>
                <p class="mt-2 text-xs text-gray-500 line-clamp-2">{r.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </article>
  </main>

  <Footer />
</BaseLayout>
