---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdminNav from '../../components/AdminNav.astro';
import '../../styles/global.css';
---

<BaseLayout title="Users & Trial Deployments — ZoomPhant Admin">
  <Header currentPath={Astro.url.pathname} />
  <AdminNav activeTab="users" />

  <main class="min-h-screen bg-gray-50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto space-y-8">
      
      <!-- Top Title Bar -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-extrabold text-gray-900 tracking-tight">Customer Deployments & User Directory</h2>
          <p class="text-xs text-gray-500 mt-0.5">Audit customer BYOC clusters provisioned on Cloudflare and browse user accounts.</p>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Deployments</span>
          <div id="statTotalDeployments" class="text-3xl font-extrabold text-gray-900 mt-2">—</div>
          <span class="text-xs text-brand-600 font-medium mt-1 inline-block">Cloudflare clusters</span>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Healthy Clusters</span>
          <div id="statSuccessDeployments" class="text-3xl font-extrabold text-emerald-600 mt-2">—</div>
          <span class="text-xs text-emerald-600 font-medium mt-1 inline-flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span> Live on Cloudflare
          </span>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Signed-Up Users</span>
          <div id="statTotalUsers" class="text-3xl font-extrabold text-gray-900 mt-2">—</div>
          <span class="text-xs text-gray-500 font-medium mt-1 inline-block">Credentials & OAuth</span>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Business Registrations</span>
          <div id="statTotalRegistrations" class="text-3xl font-extrabold text-gray-900 mt-2">—</div>
          <span class="text-xs text-gray-500 font-medium mt-1 inline-block">Community tier licenses</span>
        </div>
      </div>

      <!-- Main Tabbed Directory Card -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
        
        <!-- Tab Bar Header -->
        <div class="px-6 pt-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex space-x-6 overflow-x-auto" id="userTabsHeader">
            <button
              type="button"
              id="tabBtnDeployments"
              class="pb-4 px-1 border-b-2 border-brand-600 text-brand-600 font-bold text-sm flex items-center gap-2 cursor-pointer transition-colors"
            >
              <span>🚀 Trial Deployments</span>
              <span id="badgeDeployments" class="rounded-full bg-brand-50 px-2 py-0.5 text-xs text-brand-700">0</span>
            </button>

            <button
              type="button"
              id="tabBtnUsers"
              class="pb-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium text-sm flex items-center gap-2 cursor-pointer transition-colors"
            >
              <span>👥 Platform Users</span>
              <span id="badgeUsers" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">0</span>
            </button>

            <button
              type="button"
              id="tabBtnRegistrations"
              class="pb-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 font-medium text-sm flex items-center gap-2 cursor-pointer transition-colors"
            >
              <span>🏢 Business Licenses</span>
              <span id="badgeRegistrations" class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-600">0</span>
            </button>
          </div>

          <!-- Quick Filters (Dynamic per active tab) -->
          <div id="deploymentsFilterContainer" class="flex items-center gap-2 pb-4 sm:pb-3">
            <label for="statusFilter" class="text-xs text-gray-400">Status:</label>
            <select id="statusFilter" class="rounded-xl border border-gray-300 bg-white px-3 py-1.5 text-xs text-gray-700 shadow-sm focus:outline-none">
              <option value="all">All Deployments</option>
              <option value="success">Success Only</option>
              <option value="failed">Failed Only</option>
              <option value="in_progress">In Progress</option>
            </select>
          </div>
        </div>

        <!-- Tab Panel 1: Customer Trial Deployments -->
        <div id="panelDeployments" class="block">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3.5">Deployment ID / Time</th>
                  <th class="px-6 py-3.5">User Account</th>
                  <th class="px-6 py-3.5">Worker URL</th>
                  <th class="px-6 py-3.5">Cloudflare Account ID</th>
                  <th class="px-6 py-3.5">Version</th>
                  <th class="px-6 py-3.5">Status</th>
                  <th class="px-6 py-3.5">Diagnostics</th>
                </tr>
              </thead>
              <tbody id="deploymentsTableBody" class="divide-y divide-gray-100 text-xs font-mono">
                <tr>
                  <td colspan="7" class="px-6 py-8 text-center text-gray-400 font-sans">
                    Loading deployment records...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Panel 2: Registered Platform Users -->
        <div id="panelUsers" class="hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3.5">User ID</th>
                  <th class="px-6 py-3.5">Name</th>
                  <th class="px-6 py-3.5">Email</th>
                  <th class="px-6 py-3.5">Role</th>
                  <th class="px-6 py-3.5">Status</th>
                  <th class="px-6 py-3.5">Organization</th>
                  <th class="px-6 py-3.5">Created Date</th>
                  <th class="px-6 py-3.5 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="usersTableBody" class="divide-y divide-gray-100 text-xs">
                <tr>
                  <td colspan="8" class="px-6 py-8 text-center text-gray-400 font-sans">
                    Loading registered users...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab Panel 3: Community Business Registrations -->
        <div id="panelRegistrations" class="hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-600">
              <thead class="bg-gray-50 text-xs font-semibold text-gray-500 uppercase border-b border-gray-100">
                <tr>
                  <th class="px-6 py-3.5">Company</th>
                  <th class="px-6 py-3.5">Contact Email</th>
                  <th class="px-6 py-3.5">Company Size</th>
                  <th class="px-6 py-3.5">Infrastructure</th>
                  <th class="px-6 py-3.5">Website</th>
                  <th class="px-6 py-3.5">Registration Date</th>
                </tr>
              </thead>
              <tbody id="regTableBody" class="divide-y divide-gray-100 text-xs">
                <tr>
                  <td colspan="6" class="px-6 py-8 text-center text-gray-400 font-sans">
                    Loading business registrations...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>

    <!-- In-page Toast Notification -->
    <div id="adminToast" class="fixed bottom-5 right-5 z-50 hidden max-w-sm rounded-2xl border px-4 py-3 text-xs font-semibold shadow-xl transition-all"></div>

    <!-- In-page User Action Confirmation Modal (Disable / Enable / Purge) -->
    <div
      id="userActionModal"
      class="fixed inset-0 z-50 hidden bg-gray-900/60 flex items-center justify-center p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="userActionModalTitle"
    >
      <div class="w-full max-w-md rounded-2xl bg-white border border-gray-200 shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/70">
          <h3 id="userActionModalTitle" class="text-base font-bold text-gray-900">Confirm Action</h3>
          <button type="button" id="closeUserActionModalBtn" class="rounded-lg p-1 text-gray-400 hover:text-gray-600 hover:bg-gray-100 cursor-pointer">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <div class="p-6 space-y-4">
          <p id="userActionModalDesc" class="text-xs sm:text-sm text-gray-600 leading-relaxed"></p>

          <!-- Typed email confirmation (shown only for permanent purge) -->
          <div id="purgeConfirmWrap" class="hidden space-y-2">
            <label for="purgeConfirmInput" class="block text-xs font-semibold text-gray-700">
              Type <span id="purgeConfirmTargetEmail" class="font-mono text-red-700"></span> to confirm permanent purge:
            </label>
            <input
              type="text"
              id="purgeConfirmInput"
              autocomplete="off"
              placeholder="Enter user email"
              class="w-full rounded-xl border border-gray-300 px-3 py-2 text-xs font-mono text-gray-900 focus:border-red-500 focus:outline-none"
            />
          </div>

          <div id="userActionModalError" class="hidden rounded-xl bg-red-50 border border-red-200 px-3 py-2 text-xs text-red-700"></div>

          <div class="flex items-center justify-end gap-2 pt-2">
            <button
              type="button"
              id="cancelUserActionBtn"
              class="px-4 py-2 rounded-xl border border-gray-200 bg-white text-xs font-semibold text-gray-700 hover:bg-gray-50 cursor-pointer"
            >
              Cancel
            </button>
            <button
              type="button"
              id="confirmUserActionBtn"
              class="px-4 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition-colors cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            >
              Confirm
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    import { apiClient } from '../../utils/apiClient';

    // 1. Guard route: Verify Admin Authentication
    const token = localStorage.getItem('zp_token');
    const userStr = localStorage.getItem('zp_user');
    let user = null;

    try {
      if (userStr) user = JSON.parse(userStr);
    } catch {}

    if (!token) {
      window.location.href = '/login/?redirect=/admin/users/';
    } else if (user?.role !== 'admin') {
      window.location.href = '/dashboard/';
    }

    // Tab buttons & panels
    const tabBtnDeployments = document.getElementById('tabBtnDeployments');
    const tabBtnUsers = document.getElementById('tabBtnUsers');
    const tabBtnRegistrations = document.getElementById('tabBtnRegistrations');

    const panelDeployments = document.getElementById('panelDeployments');
    const panelUsers = document.getElementById('panelUsers');
    const panelRegistrations = document.getElementById('panelRegistrations');
    const deploymentsFilterContainer = document.getElementById('deploymentsFilterContainer');

    const badgeDeployments = document.getElementById('badgeDeployments');
    const badgeUsers = document.getElementById('badgeUsers');
    const badgeRegistrations = document.getElementById('badgeRegistrations');

    const statTotalDeployments = document.getElementById('statTotalDeployments');
    const statSuccessDeployments = document.getElementById('statSuccessDeployments');
    const statTotalUsers = document.getElementById('statTotalUsers');
    const statTotalRegistrations = document.getElementById('statTotalRegistrations');

    const deploymentsTableBody = document.getElementById('deploymentsTableBody');
    const usersTableBody = document.getElementById('usersTableBody');
    const regTableBody = document.getElementById('regTableBody');
    const statusFilter = document.getElementById('statusFilter') as HTMLSelectElement;

    let allDeployments: any[] = [];
    let allUsers: any[] = [];
    let allRegistrations: any[] = [];

    // Tab switching logic
    function switchTab(activeTab: 'deployments' | 'users' | 'registrations') {
      const activeClasses = ['border-brand-600', 'text-brand-600', 'font-bold'];
      const inactiveClasses = ['border-transparent', 'text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300'];

      // Reset all buttons
      [tabBtnDeployments, tabBtnUsers, tabBtnRegistrations].forEach((btn) => {
        btn?.classList.remove(...activeClasses);
        btn?.classList.add(...inactiveClasses);
      });

      // Hide all panels
      panelDeployments?.classList.add('hidden');
      panelUsers?.classList.add('hidden');
      panelRegistrations?.classList.add('hidden');
      deploymentsFilterContainer?.classList.add('hidden');

      if (activeTab === 'deployments') {
        tabBtnDeployments?.classList.add(...activeClasses);
        tabBtnDeployments?.classList.remove(...inactiveClasses);
        panelDeployments?.classList.remove('hidden');
        deploymentsFilterContainer?.classList.remove('hidden');
      } else if (activeTab === 'users') {
        tabBtnUsers?.classList.add(...activeClasses);
        tabBtnUsers?.classList.remove(...inactiveClasses);
        panelUsers?.classList.remove('hidden');
      } else {
        tabBtnRegistrations?.classList.add(...activeClasses);
        tabBtnRegistrations?.classList.remove(...inactiveClasses);
        panelRegistrations?.classList.remove('hidden');
      }
    }

    tabBtnDeployments?.addEventListener('click', () => switchTab('deployments'));
    tabBtnUsers?.addEventListener('click', () => switchTab('users'));
    tabBtnRegistrations?.addEventListener('click', () => switchTab('registrations'));

    async function loadData() {
      try {
        const [depData, usersData] = await Promise.all([
          apiClient('/api/admin/deployments', { token }),
          apiClient('/api/admin/users', { token }),
        ]);

        allDeployments = depData.deployments || [];
        allUsers = usersData.users || [];
        allRegistrations = usersData.registrations || [];

        // Render summary metrics
        if (statTotalDeployments) statTotalDeployments.textContent = allDeployments.length.toString();
        const successCount = allDeployments.filter((d: any) => d.status === 'success').length;
        if (statSuccessDeployments) statSuccessDeployments.textContent = successCount.toString();
        if (statTotalUsers) statTotalUsers.textContent = allUsers.length.toString();
        if (statTotalRegistrations) statTotalRegistrations.textContent = allRegistrations.length.toString();

        if (badgeDeployments) badgeDeployments.textContent = allDeployments.length.toString();
        if (badgeUsers) badgeUsers.textContent = allUsers.length.toString();
        if (badgeRegistrations) badgeRegistrations.textContent = allRegistrations.length.toString();

        renderDeployments();
        renderUsers();
        renderRegistrations();

      } catch (err: any) {
        console.error('Failed to load data:', err);
      }
    }

    function renderDeployments() {
      if (!deploymentsTableBody) return;
      const filter = statusFilter?.value || 'all';

      const filtered = allDeployments.filter((d: any) => {
        if (filter === 'all') return true;
        return d.status === filter;
      });

      if (filtered.length === 0) {
        deploymentsTableBody.innerHTML = `
          <tr>
            <td colspan="7" class="px-6 py-8 text-center text-gray-400 font-sans">
              No deployments matching "${filter}".
            </td>
          </tr>
        `;
        return;
      }

      deploymentsTableBody.innerHTML = filtered.map((d: any) => {
        const dateStr = new Date(d.created_at).toLocaleString();
        const userDisplay = d.user_email
          ? `<span class="font-sans font-semibold text-gray-900">${d.user_email}</span>`
          : d.user_id && d.user_id !== 'guest_trial_user'
          ? `<span class="text-gray-600">${d.user_id}</span>`
          : `<span class="font-sans text-gray-400 italic">Guest User</span>`;

        const statusBadge = d.status === 'success'
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20 font-sans"><span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Live</span>`
          : d.status === 'failed'
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-50 text-red-700 ring-1 ring-inset ring-red-600/20 font-sans"><span class="h-1.5 w-1.5 rounded-full bg-red-600"></span> Failed</span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-yellow-50 text-yellow-700 ring-1 ring-inset ring-yellow-600/20 font-sans">In Progress</span>`;

        return `
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="font-bold text-gray-900">${d.id}</span><br/>
              <span class="text-[11px] text-gray-400 font-sans">${dateStr}</span>
            </td>
            <td class="px-6 py-4">
              ${userDisplay}
            </td>
            <td class="px-6 py-4">
              ${d.worker_url
                ? `<a href="${d.worker_url}" target="_blank" class="text-brand-600 hover:text-brand-800 underline truncate block max-w-xs">${d.worker_url}</a>`
                : `<span class="text-gray-400 font-sans italic">—</span>`
              }
            </td>
            <td class="px-6 py-4 text-gray-500 font-mono">
              ${d.cf_account_id}
            </td>
            <td class="px-6 py-4 font-bold text-gray-700">
              v${d.release_version}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              ${statusBadge}
            </td>
            <td class="px-6 py-4 font-sans text-xs max-w-xs truncate" title="${d.error_message || ''}">
              ${d.error_message
                ? `<span class="text-red-600 font-medium">${d.error_message}</span>`
                : `<span class="text-emerald-600 font-medium">Provisioned OK</span>`
              }
            </td>
          </tr>
        `;
      }).join('');
    }

    function renderUsers() {
      if (!usersTableBody) return;

      if (allUsers.length === 0) {
        usersTableBody.innerHTML = `
          <tr>
            <td colspan="8" class="px-6 py-8 text-center text-gray-400">
              No registered platform users found.
            </td>
          </tr>
        `;
        return;
      }

      usersTableBody.innerHTML = allUsers.map((u: any) => {
        let metaCompany = '—';
        let parsedMeta: any = {};
        try {
          if (u.metadata) {
            parsedMeta = typeof u.metadata === 'string' ? JSON.parse(u.metadata) : u.metadata;
            if (parsedMeta.company) metaCompany = parsedMeta.company;
          }
        } catch {}

        const isDisabled = Boolean(u.disabled ?? parsedMeta.disabled);
        const isProtected = Boolean(u.protected || u.role === 'admin' || u.id === 'usr_admin_zoomphant' || parsedMeta.is_super_admin);

        const statusBadge = isDisabled
          ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">Disabled</span>`
          : `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>`;

        const actionsHtml = isProtected
          ? `<span class="inline-flex items-center gap-1 text-[11px] font-medium text-gray-400" title="Super users and administrators cannot be disabled or purged">Protected</span>`
          : isDisabled
          ? `
            <div class="inline-flex items-center justify-end gap-2">
              <button
                type="button"
                data-toggle-user-id="${u.id}"
                data-toggle-user-email="${u.email}"
                data-next-disabled="false"
                class="toggle-user-status-btn px-2.5 py-1 rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 text-[11px] font-semibold cursor-pointer transition-colors"
              >
                Enable
              </button>
              <button
                type="button"
                data-purge-user-id="${u.id}"
                data-purge-user-email="${u.email}"
                class="purge-user-btn px-2.5 py-1 rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 text-[11px] font-semibold cursor-pointer transition-colors"
                title="Permanently delete user and all associated data"
              >
                Purge Data
              </button>
            </div>
          `
          : `
            <button
              type="button"
              data-toggle-user-id="${u.id}"
              data-toggle-user-email="${u.email}"
              data-next-disabled="true"
              class="toggle-user-status-btn px-2.5 py-1 rounded-lg border border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100 text-[11px] font-semibold cursor-pointer transition-colors"
              title="Disable account and revoke active sessions"
            >
              Disable
            </button>
          `;

        return `
          <tr class="hover:bg-gray-50/50 transition-colors ${isDisabled ? 'bg-gray-50/60 opacity-85' : ''}">
            <td class="px-6 py-4 font-mono text-gray-500">${u.id}</td>
            <td class="px-6 py-4 font-semibold text-gray-900">${u.name}</td>
            <td class="px-6 py-4 text-gray-600">${u.email}</td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                u.role === 'admin' ? 'bg-purple-50 text-purple-700 border border-purple-200' : 'bg-gray-100 text-gray-700'
              }">
                ${u.role}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">${statusBadge}</td>
            <td class="px-6 py-4 text-gray-500">${metaCompany}</td>
            <td class="px-6 py-4 text-gray-400 whitespace-nowrap">${new Date(u.createdAt).toLocaleDateString()}</td>
            <td class="px-6 py-4 text-right whitespace-nowrap">${actionsHtml}</td>
          </tr>
        `;
      }).join('');

      document.querySelectorAll('.toggle-user-status-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLElement;
          const id = el.getAttribute('data-toggle-user-id');
          const email = el.getAttribute('data-toggle-user-email') || id || '';
          const nextDisabled = el.getAttribute('data-next-disabled') === 'true';
          if (!id) return;
          openUserActionModal({
            mode: nextDisabled ? 'disable' : 'enable',
            userId: id,
            email,
          });
        });
      });

      document.querySelectorAll('.purge-user-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const el = e.currentTarget as HTMLElement;
          const id = el.getAttribute('data-purge-user-id');
          const email = el.getAttribute('data-purge-user-email') || '';
          if (!id) return;
          openUserActionModal({
            mode: 'purge',
            userId: id,
            email,
          });
        });
      });
    }

    // In-page Toast + Modal State
    const adminToast = document.getElementById('adminToast');
    const userActionModal = document.getElementById('userActionModal');
    const userActionModalTitle = document.getElementById('userActionModalTitle');
    const userActionModalDesc = document.getElementById('userActionModalDesc');
    const purgeConfirmWrap = document.getElementById('purgeConfirmWrap');
    const purgeConfirmTargetEmail = document.getElementById('purgeConfirmTargetEmail');
    const purgeConfirmInput = document.getElementById('purgeConfirmInput') as HTMLInputElement;
    const userActionModalError = document.getElementById('userActionModalError');
    const closeUserActionModalBtn = document.getElementById('closeUserActionModalBtn');
    const cancelUserActionBtn = document.getElementById('cancelUserActionBtn');
    const confirmUserActionBtn = document.getElementById('confirmUserActionBtn') as HTMLButtonElement;

    let pendingUserAction: { mode: 'disable' | 'enable' | 'purge'; userId: string; email: string } | null = null;
    let toastTimer: ReturnType<typeof setTimeout> | null = null;

    function showToast(message: string, kind: 'success' | 'error' = 'success') {
      if (!adminToast) return;
      adminToast.textContent = message;
      adminToast.className = `fixed bottom-5 right-5 z-50 max-w-sm rounded-2xl border px-4 py-3 text-xs font-semibold shadow-xl transition-all ${
        kind === 'error'
          ? 'bg-red-50 border-red-200 text-red-800'
          : 'bg-emerald-50 border-emerald-200 text-emerald-800'
      }`;
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        adminToast.classList.add('hidden');
      }, 4500);
    }

    function closeUserActionModal() {
      pendingUserAction = null;
      userActionModal?.classList.add('hidden');
      userActionModalError?.classList.add('hidden');
    }

    function openUserActionModal(action: { mode: 'disable' | 'enable' | 'purge'; userId: string; email: string }) {
      pendingUserAction = action;
      userActionModalError?.classList.add('hidden');
      if (purgeConfirmInput) purgeConfirmInput.value = '';

      if (action.mode === 'disable') {
        if (userActionModalTitle) userActionModalTitle.textContent = 'Disable User Account';
        if (userActionModalDesc) {
          userActionModalDesc.textContent = `Disable "${action.email}"? All active sessions will be revoked immediately and the user will be blocked from signing in until re-enabled.`;
        }
        purgeConfirmWrap?.classList.add('hidden');
        if (confirmUserActionBtn) {
          confirmUserActionBtn.textContent = 'Disable User';
          confirmUserActionBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition-colors cursor-pointer bg-amber-600 hover:bg-amber-700 disabled:opacity-40 disabled:cursor-not-allowed';
          confirmUserActionBtn.disabled = false;
        }
      } else if (action.mode === 'enable') {
        if (userActionModalTitle) userActionModalTitle.textContent = 'Re-enable User Account';
        if (userActionModalDesc) {
          userActionModalDesc.textContent = `Re-enable "${action.email}" so they can sign in and access their dashboard again?`;
        }
        purgeConfirmWrap?.classList.add('hidden');
        if (confirmUserActionBtn) {
          confirmUserActionBtn.textContent = 'Re-enable User';
          confirmUserActionBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition-colors cursor-pointer bg-emerald-600 hover:bg-emerald-700 disabled:opacity-40 disabled:cursor-not-allowed';
          confirmUserActionBtn.disabled = false;
        }
      } else {
        if (userActionModalTitle) userActionModalTitle.textContent = 'Permanently Purge User & Data';
        if (userActionModalDesc) {
          userActionModalDesc.textContent = `This will permanently delete "${action.email}" and purge all of their sessions, OAuth/password credentials, deployment records, and email logs. This cannot be undone.`;
        }
        if (purgeConfirmTargetEmail) purgeConfirmTargetEmail.textContent = action.email;
        purgeConfirmWrap?.classList.remove('hidden');
        if (confirmUserActionBtn) {
          confirmUserActionBtn.textContent = 'Permanently Purge';
          confirmUserActionBtn.className = 'px-4 py-2 rounded-xl text-xs font-semibold text-white shadow-xs transition-colors cursor-pointer bg-red-600 hover:bg-red-700 disabled:opacity-40 disabled:cursor-not-allowed';
          confirmUserActionBtn.disabled = true;
        }
      }

      userActionModal?.classList.remove('hidden');
      if (action.mode === 'purge') purgeConfirmInput?.focus();
    }

    purgeConfirmInput?.addEventListener('input', () => {
      if (!pendingUserAction || pendingUserAction.mode !== 'purge' || !confirmUserActionBtn) return;
      confirmUserActionBtn.disabled =
        purgeConfirmInput.value.trim().toLowerCase() !== pendingUserAction.email.toLowerCase();
    });

    closeUserActionModalBtn?.addEventListener('click', closeUserActionModal);
    cancelUserActionBtn?.addEventListener('click', closeUserActionModal);
    userActionModal?.addEventListener('click', (e) => {
      if (e.target === userActionModal) closeUserActionModal();
    });

    confirmUserActionBtn?.addEventListener('click', async () => {
      if (!pendingUserAction || !confirmUserActionBtn) return;
      const { mode, userId, email } = pendingUserAction;
      userActionModalError?.classList.add('hidden');
      confirmUserActionBtn.disabled = true;
      const prevLabel = confirmUserActionBtn.textContent;
      confirmUserActionBtn.textContent = mode === 'purge' ? 'Purging…' : 'Updating…';

      try {
        if (mode === 'purge') {
          await apiClient(`/api/admin/users/${encodeURIComponent(userId)}`, {
            method: 'DELETE',
            token,
          });
          closeUserActionModal();
          showToast(`Permanently purged ${email} and all associated data.`);
        } else {
          const disabled = mode === 'disable';
          await apiClient(`/api/admin/users/${encodeURIComponent(userId)}/status`, {
            method: 'PATCH',
            token,
            body: JSON.stringify({ disabled }),
          });
          closeUserActionModal();
          showToast(disabled ? `Disabled ${email} and revoked active sessions.` : `Re-enabled ${email}.`);
        }
        await loadData();
      } catch (err: any) {
        confirmUserActionBtn.disabled = false;
        confirmUserActionBtn.textContent = prevLabel;
        if (userActionModalError) {
          userActionModalError.textContent = err.message || 'Operation failed.';
          userActionModalError.classList.remove('hidden');
        }
      }
    });

    function renderRegistrations() {
      if (!regTableBody) return;

      if (allRegistrations.length === 0) {
        regTableBody.innerHTML = `
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-gray-400">
              No business registrations found.
            </td>
          </tr>
        `;
        return;
      }

      regTableBody.innerHTML = allRegistrations.map((r: any) => `
        <tr class="hover:bg-gray-50/50 transition-colors">
          <td class="px-6 py-4 font-semibold text-gray-900">${r.company}</td>
          <td class="px-6 py-4 text-gray-600">${r.email}</td>
          <td class="px-6 py-4 text-gray-500">${r.company_size || '—'}</td>
          <td class="px-6 py-4 text-gray-500 capitalize">${r.infrastructure || '—'}</td>
          <td class="px-6 py-4">
            ${r.website
              ? `<a href="${r.website}" target="_blank" class="text-brand-600 hover:text-brand-700 underline truncate block max-w-xs">${r.website}</a>`
              : '—'
            }
          </td>
          <td class="px-6 py-4 text-gray-400 whitespace-nowrap">${new Date(r.created_at).toLocaleDateString()}</td>
        </tr>
      `).join('');
    }

    statusFilter?.addEventListener('change', renderDeployments);

    // Initial load
    loadData();
  </script>
</BaseLayout>
