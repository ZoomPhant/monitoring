---
export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isDocs = currentPath.startsWith('/docs');
---

<header class="sticky top-0 z-50 w-full border-b border-gray-100 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2.5 text-xl font-bold text-gray-900">
      <img src="/logo.svg" alt="ZoomPhant" class="h-8 w-8" />
      ZoomPhant
    </a>
    
    <!-- Desktop Navigation Links -->
    <div class="hidden items-center gap-8 md:flex">
      <a
        href="/"
        class="text-sm font-medium transition-colors"
        class:list={[currentPath === '/' ? 'text-brand-600' : 'text-gray-600 hover:text-gray-900']}
      >Home</a>
      <a
        href="/docs/start/"
        class="text-sm font-medium transition-colors"
        class:list={[isDocs ? 'text-brand-600' : 'text-gray-600 hover:text-gray-900']}
      >Docs</a>
      <a
        href="/docs/about/"
        class="text-sm font-medium text-gray-600 transition-colors hover:text-gray-900"
      >About</a>
      <a
        href="https://github.com/ZoomPhant/monitoring"
        class="text-sm font-medium text-gray-600 transition-colors hover:text-gray-900"
      >GitHub</a>
    </div>

    <!-- Right-side Auth & Actions -->
    <div class="flex items-center gap-3">
      
      <!-- Logged-out state buttons (default visible before JS hydration) -->
      <div id="loggedOutButtons" class="flex items-center gap-2.5">
        <a
          href="/login/"
          class="rounded-lg border border-gray-200 bg-white px-3.5 py-2 text-xs font-semibold text-gray-700 transition-all hover:bg-gray-50"
        >
          Sign In
        </a>
        <a
          href="/trial/"
          class="rounded-lg bg-brand-600 px-3.5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-brand-700 transition-colors"
        >
          Try TSDB →
        </a>
      </div>

      <!-- Logged-in Profile Menu (Hidden by default, shown by JS) -->
      <div id="loggedInProfile" class="relative hidden">
        <button
          type="button"
          id="profileMenuBtn"
          class="flex items-center gap-2 rounded-full border border-gray-200 bg-white py-1.5 pl-3 pr-2 text-xs font-semibold text-gray-800 hover:bg-gray-50 transition-all shadow-sm cursor-pointer"
        >
          <span id="headerUserName" class="max-w-[120px] truncate">Admin</span>
          <span id="adminBadge" class="hidden rounded-full bg-brand-100 px-1.5 py-0.5 text-[10px] font-bold text-brand-700">Admin</span>
          <svg class="h-4 w-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div
          id="profileDropdown"
          class="absolute right-0 mt-2 w-56 origin-top-right rounded-2xl bg-white p-2 shadow-xl ring-1 ring-black/5 divide-y divide-gray-100 hidden z-50"
        >
          <div class="px-3 py-2 text-xs">
            <p class="font-bold text-gray-900 truncate" id="dropdownName">Admin User</p>
            <p class="text-gray-500 truncate mt-0.5" id="dropdownEmail">admin@zoomphant.com</p>
          </div>
          
          <div class="py-1">
            <a
              href="/trial/"
              class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-gray-700 hover:bg-gray-50 transition-colors"
            >
              🚀 Launch TSDB Cluster
            </a>
            <!-- Admin link (only shown if role === 'admin') -->
            <a
              id="adminConsoleLink"
              href="/admin/"
              class="hidden flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-brand-700 bg-brand-50/50 hover:bg-brand-50 transition-colors"
            >
              ⚙️ Admin Console
            </a>
          </div>

          <div class="pt-1">
            <button
              type="button"
              id="signOutBtn"
              class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-red-600 hover:bg-red-50 transition-colors text-left cursor-pointer"
            >
              Sign Out
            </button>
          </div>
        </div>
      </div>

    </div>
  </nav>
</header>

<script>
  // Check client-side authentication state
  function updateAuthHeader() {
    const token = localStorage.getItem('zp_token');
    const userStr = localStorage.getItem('zp_user');
    
    const loggedOutDiv = document.getElementById('loggedOutButtons');
    const loggedInDiv = document.getElementById('loggedInProfile');
    const headerUserName = document.getElementById('headerUserName');
    const adminBadge = document.getElementById('adminBadge');
    const adminConsoleLink = document.getElementById('adminConsoleLink');
    const dropdownName = document.getElementById('dropdownName');
    const dropdownEmail = document.getElementById('dropdownEmail');

    if (token && userStr) {
      try {
        const user = JSON.parse(userStr);
        if (loggedOutDiv) loggedOutDiv.classList.add('hidden');
        if (loggedInDiv) loggedInDiv.classList.remove('hidden');

        if (headerUserName) headerUserName.textContent = user.name || user.email.split('@')[0];
        if (dropdownName) dropdownName.textContent = user.name || 'User';
        if (dropdownEmail) dropdownEmail.textContent = user.email;

        if (user.role === 'admin') {
          if (adminBadge) adminBadge.classList.remove('hidden');
          if (adminConsoleLink) adminConsoleLink.classList.remove('hidden');
        }
      } catch {
        // Corrupted session
        localStorage.removeItem('zp_token');
        localStorage.removeItem('zp_user');
      }
    } else {
      if (loggedOutDiv) loggedOutDiv.classList.remove('hidden');
      if (loggedInDiv) loggedInDiv.classList.add('hidden');
    }
  }

  // Toggle Dropdown
  const profileMenuBtn = document.getElementById('profileMenuBtn');
  const profileDropdown = document.getElementById('profileDropdown');

  profileMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    profileDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    profileDropdown?.classList.add('hidden');
  });

  // Sign Out Handler
  const signOutBtn = document.getElementById('signOutBtn');
  signOutBtn?.addEventListener('click', () => {
    localStorage.removeItem('zp_token');
    localStorage.removeItem('zp_user');
    window.location.href = '/';
  });

  // Run on mount
  updateAuthHeader();
</script>
