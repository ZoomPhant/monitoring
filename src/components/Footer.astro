<footer class="border-t border-gray-100 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <!-- Single row layout for all 5 columns on desktop -->
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-5">
      <div class="sm:col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5">
          <img src="/logo.svg" alt="ZoomPhant" class="h-8 w-8" />
          <div class="flex flex-col">
            <span class="text-lg font-extrabold leading-none tracking-tight text-gray-900">ZoomPhant</span>
            <span class="mt-0.5 text-[9px] font-semibold uppercase tracking-widest text-brand-600">Your Monitoring Expert</span>
          </div>
        </div>
        <p class="mt-3 text-xs text-gray-500 leading-relaxed">
          AI-native TSDB & enterprise monitoring solutions built for full data ownership.
        </p>
      </div>
      <div>
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-900">Product</h4>
        <ul class="space-y-2 text-xs text-gray-500">
          <li><a href="/docs/start/" class="transition-colors hover:text-gray-900">Quick Start</a></li>
          <li><a href="/docs/about/" class="transition-colors hover:text-gray-900">Why ZoomPhant</a></li>
          <li><a href="/docs/about/work/" class="transition-colors hover:text-gray-900">How It Works</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-900">Docs</h4>
        <ul class="space-y-2 text-xs text-gray-500">
          <li><a href="/docs/manual/" class="transition-colors hover:text-gray-900">References</a></li>
          <li><a href="/docs/concepts/" class="transition-colors hover:text-gray-900">Concepts</a></li>
          <li><a href="/docs/about/qa/" class="transition-colors hover:text-gray-900">FAQ</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-900">Community</h4>
        <ul class="space-y-2 text-xs text-gray-500">
          <li><a href="https://github.com/ZoomPhant/monitoring" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-gray-900">GitHub</a></li>
          <li><a href="https://github.com/ZoomPhant/monitoring/issues" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-gray-900">Issues</a></li>
          <li><a href="mailto:info@zoomphant.com" class="transition-colors hover:text-gray-900">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wider text-gray-900">Legal</h4>
        <ul class="space-y-2 text-xs text-gray-500">
          <li><a href="/privacy/" class="transition-colors hover:text-gray-900">Privacy Policy</a></li>
          <li><a href="/terms/" class="transition-colors hover:text-gray-900">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-gray-200 pt-6 text-center text-xs text-gray-400">
      &copy; {new Date().getFullYear()} ZoomPhant. All rights reserved.
    </div>
  </div>
</footer>
