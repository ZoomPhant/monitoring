# Docker Images to Sync - Auto-versioned from RELEASE file
# Format: IMAGE_NAME:RELEASE_KEY
# The sync workflow reads RELEASE file to get actual versions
# For each image, it syncs both vX.Y.Z and latest tags
#
# Source: SOURCE_DOCKER_REGISTRY/SOURCE_DOCKER_ORG/IMAGE_NAME:{vX.Y.Z,latest}
# Target: ZPDOCKER_REGISTRY/TARGET_DOCKER_ORG/IMAGE_NAME:{vX.Y.Z,latest}
#
# RELEASE_KEY mapping:
#   collector → collector#X.Y.Z in RELEASE (auto-updated)
#   operator  → operator#X.Y.Z in RELEASE (manual update)
#   central   → central#X.Y.Z in RELEASE (manual update)
#   normal    → normal#X.Y.Z in RELEASE (manual update)

# Collector-based images (use collector version)
collector:collector
aio:collector
collector-packages:collector
collector-installer:collector
pack:collector

# Operator image
zp-operator:operator

# Metrics images
zpmetrics:central
dockermetrics:normal
