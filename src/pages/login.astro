---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout title="Sign In & Account — ZoomPhant">
  <Header currentPath={Astro.url.pathname} />

  <main class="min-h-screen bg-gray-50 flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl w-full bg-white p-8 sm:p-10 rounded-3xl border border-gray-200 shadow-xl shadow-gray-100/50">
      
      <!-- Brand Header -->
      <div class="text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 text-2xl font-bold text-gray-900 mb-2">
          <img src="/logo.svg" alt="ZoomPhant" class="h-9 w-9" />
          ZoomPhant
        </a>
        <h2 id="pageTitle" class="text-xl font-bold text-gray-900 mt-2">Welcome Back</h2>
        <p id="pageSubtitle" class="text-xs text-gray-500 mt-1">Sign in to manage your deployments and access your TSDB clusters.</p>
      </div>

      <!-- Error / Alert Banner -->
      <div id="authAlert" class="hidden p-3.5 rounded-xl text-xs font-medium border mb-6"></div>

      <!-- 2-Column Auth Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 relative">

        <!-- Column 1: Email & Password (Sign In / Sign Up / Verify / Forgot) -->
        <div class="space-y-5">
          
          <!-- Mode Tabs (Visible on Sign In / Sign Up) -->
          <div id="authTabsContainer" class="flex rounded-xl bg-gray-100 p-1 text-xs font-semibold">
            <button
              type="button"
              id="tabSignIn"
              class="flex-1 rounded-lg py-2 text-center text-gray-900 bg-white shadow-sm transition-all cursor-pointer"
            >
              Sign In
            </button>
            <button
              type="button"
              id="tabSignUp"
              class="flex-1 rounded-lg py-2 text-center text-gray-500 hover:text-gray-900 transition-all cursor-pointer"
            >
              Create Account
            </button>
          </div>

          <!-- Form 1: Sign In -->
          <form id="signInForm" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Email Address</label>
              <input
                type="email"
                id="signInEmail"
                required
                placeholder="name@company.com"
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-semibold text-gray-700">Password</label>
                <button
                  type="button"
                  id="forgotPasswordLink"
                  class="text-xs text-brand-600 hover:text-brand-700 hover:underline cursor-pointer"
                >
                  Forgot password?
                </button>
              </div>
              <input
                type="password"
                id="signInPassword"
                required
                placeholder="••••••••"
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <button
              type="submit"
              id="signInBtn"
              class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-md hover:bg-brand-700 transition-all cursor-pointer mt-2"
            >
              Sign In
            </button>
          </form>

          <!-- Form 2: Sign Up (Initial details) -->
          <form id="signUpForm" class="hidden space-y-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Full Name</label>
              <input
                type="text"
                id="signUpName"
                required
                placeholder="Alex Rivera"
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Email Address</label>
              <input
                type="email"
                id="signUpEmail"
                required
                placeholder="alex@company.com"
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Company / Organization</label>
              <input
                type="text"
                id="signUpCompany"
                placeholder="Acme Inc."
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Password</label>
              <input
                type="password"
                id="signUpPassword"
                required
                minlength="8"
                placeholder="At least 8 characters"
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <button
              type="submit"
              id="signUpBtn"
              class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-md hover:bg-brand-700 transition-all cursor-pointer mt-2"
            >
              Continue & Verify Email →
            </button>
          </form>

          <!-- Form 3: 6-Digit Email Verification -->
          <form id="verifyForm" class="hidden space-y-4">
            <div class="rounded-xl bg-brand-50 p-3.5 border border-brand-200 text-xs text-brand-900">
              <span class="font-bold block mb-1">Verify your email address</span>
              Enter the 6-digit verification code sent to <strong id="verifyTargetEmail" class="font-mono text-brand-700"></strong>.
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">6-Digit Verification Code</label>
              <input
                type="text"
                id="verifyCode"
                required
                maxlength="6"
                placeholder="123456"
                class="w-full text-center tracking-widest text-xl font-bold font-mono rounded-xl border border-gray-300 bg-white px-3.5 py-3 text-gray-900 shadow-sm focus:border-brand-500 focus:ring-1 focus:ring-brand-500 focus:outline-none"
              />
            </div>

            <button
              type="submit"
              id="verifySubmitBtn"
              class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-md hover:bg-brand-700 transition-all cursor-pointer"
            >
              Confirm Code & Activate
            </button>

            <div class="flex items-center justify-between pt-2 text-xs">
              <button
                type="button"
                id="resendCodeBtn"
                class="text-brand-600 hover:text-brand-700 font-semibold cursor-pointer"
              >
                Resend Code
              </button>
              <button
                type="button"
                id="backToSignInFromVerify"
                class="text-gray-500 hover:text-gray-700 cursor-pointer"
              >
                Cancel
              </button>
            </div>
          </form>

          <!-- Form 4: Forgot Password / Password Reset -->
          <form id="forgotForm" class="hidden space-y-4">
            <div class="rounded-xl bg-gray-50 p-3.5 border border-gray-200 text-xs text-gray-600">
              Enter your account email to receive a 6-digit password reset code.
            </div>

            <div id="forgotStep1">
              <label class="block text-xs font-semibold text-gray-700 mb-1">Account Email</label>
              <input
                type="email"
                id="forgotEmail"
                required
                placeholder="name@company.com"
                class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:outline-none"
              />
              <button
                type="button"
                id="sendResetCodeBtn"
                class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-md hover:bg-brand-700 transition-all cursor-pointer mt-3"
              >
                Send Reset Code
              </button>
            </div>

            <!-- Forgot Step 2: Code & New Password -->
            <div id="forgotStep2" class="hidden space-y-3">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">6-Digit Reset Code</label>
                <input
                  type="text"
                  id="resetCode"
                  maxlength="6"
                  placeholder="123456"
                  class="w-full text-center tracking-widest text-lg font-bold font-mono rounded-xl border border-gray-300 bg-white px-3.5 py-2 text-gray-900 shadow-sm focus:border-brand-500 focus:outline-none"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">New Password</label>
                <input
                  type="password"
                  id="resetNewPassword"
                  minlength="8"
                  placeholder="At least 8 characters"
                  class="w-full rounded-xl border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-brand-500 focus:outline-none"
                />
              </div>
              <button
                type="submit"
                id="resetPasswordSubmitBtn"
                class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white shadow-md hover:bg-brand-700 transition-all cursor-pointer"
              >
                Reset Password & Sign In
              </button>
            </div>

            <div class="pt-2 text-center">
              <button
                type="button"
                id="backToSignInFromForgot"
                class="text-xs text-gray-500 hover:text-gray-700 cursor-pointer"
              >
                ← Back to Sign In
              </button>
            </div>
          </form>

        </div>

        <!-- Column 2: Social Single Sign-On -->
        <div class="flex flex-col justify-between pt-6 md:pt-0 border-t md:border-t-0 md:border-l md:border-gray-200 md:pl-10 space-y-6">
          <div>
            <h3 class="text-sm font-bold text-gray-900 mb-1">Instant Single Sign-On</h3>
            <p class="text-xs text-gray-500 mb-5">Access your dashboard and self-service deployments instantly via your existing provider.</p>

            <div class="space-y-3">
              <!-- Google Sign-In -->
              <a
                id="googleAuthLink"
                href="#"
                class="flex w-full items-center justify-center gap-3 rounded-xl border border-gray-300 bg-white px-4 py-3 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition-all"
              >
                <svg class="h-4 w-4" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
                </svg>
                <span>Continue with Google</span>
              </a>

              <!-- GitHub Sign-In -->
              <a
                id="githubAuthLink"
                href="#"
                class="flex w-full items-center justify-center gap-3 rounded-xl border border-gray-300 bg-white px-4 py-3 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition-all"
              >
                <svg class="h-4 w-4 fill-gray-900" viewBox="0 0 24 24">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                </svg>
                <span>Continue with GitHub</span>
              </a>
            </div>
          </div>

          <div class="rounded-xl bg-gray-50 border border-gray-100 p-4 text-xs text-gray-500 space-y-1.5">
            <div class="font-semibold text-gray-700 flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              No Credit Card Required
            </div>
            <p>First TSDB cluster is completely free. Single-tenant deployment on your own Cloudflare infrastructure.</p>
          </div>
        </div>

      </div>

    </div>
  </main>

  <Footer />

  <script>
    import { apiClient, getOAuthUrl } from '../utils/apiClient';

    const authTabsContainer = document.getElementById('authTabsContainer');
    const tabSignIn = document.getElementById('tabSignIn');
    const tabSignUp = document.getElementById('tabSignUp');
    const signInForm = document.getElementById('signInForm') as HTMLFormElement;
    const signUpForm = document.getElementById('signUpForm') as HTMLFormElement;
    const verifyForm = document.getElementById('verifyForm') as HTMLFormElement;
    const forgotForm = document.getElementById('forgotForm') as HTMLFormElement;
    const pageTitle = document.getElementById('pageTitle');
    const pageSubtitle = document.getElementById('pageSubtitle');
    const authAlert = document.getElementById('authAlert');
    const googleAuthLink = document.getElementById('googleAuthLink') as HTMLAnchorElement;
    const githubAuthLink = document.getElementById('githubAuthLink') as HTMLAnchorElement;

    // Verify view elements
    const verifyTargetEmail = document.getElementById('verifyTargetEmail');
    const verifyCodeInput = document.getElementById('verifyCode') as HTMLInputElement;
    const resendCodeBtn = document.getElementById('resendCodeBtn');
    const backToSignInFromVerify = document.getElementById('backToSignInFromVerify');

    // Forgot password elements
    const forgotPasswordLink = document.getElementById('forgotPasswordLink');
    const forgotEmailInput = document.getElementById('forgotEmail') as HTMLInputElement;
    const sendResetCodeBtn = document.getElementById('sendResetCodeBtn');
    const forgotStep1 = document.getElementById('forgotStep1');
    const forgotStep2 = document.getElementById('forgotStep2');
    const resetCodeInput = document.getElementById('resetCode') as HTMLInputElement;
    const resetNewPasswordInput = document.getElementById('resetNewPassword') as HTMLInputElement;
    const backToSignInFromForgot = document.getElementById('backToSignInFromForgot');

    let pendingVerifyEmail = '';

    // Set OAuth Links
    if (googleAuthLink) googleAuthLink.href = getOAuthUrl('google', '/dashboard/');
    if (githubAuthLink) githubAuthLink.href = getOAuthUrl('github', '/dashboard/');

    function showAlert(msg: string, isError = true) {
      if (!authAlert) return;
      authAlert.textContent = msg;
      authAlert.className = `p-3 rounded-xl text-xs font-medium border mb-4 ${
        isError ? 'bg-red-50 text-red-700 border-red-200' : 'bg-emerald-50 text-emerald-700 border-emerald-200'
      } block`;
    }

    function hideAlert() {
      if (authAlert) authAlert.className = 'hidden';
    }

    // Switch View Helper
    function setView(view: 'signin' | 'signup' | 'verify' | 'forgot') {
      hideAlert();
      signInForm?.classList.add('hidden');
      signUpForm?.classList.add('hidden');
      verifyForm?.classList.add('hidden');
      forgotForm?.classList.add('hidden');

      if (view === 'signin') {
        authTabsContainer?.classList.remove('hidden');
        tabSignIn?.classList.add('text-gray-900', 'bg-white', 'shadow-sm');
        tabSignIn?.classList.remove('text-gray-500');
        tabSignUp?.classList.remove('text-gray-900', 'bg-white', 'shadow-sm');
        tabSignUp?.classList.add('text-gray-500');
        signInForm?.classList.remove('hidden');
        if (pageTitle) pageTitle.textContent = 'Welcome Back';
        if (pageSubtitle) pageSubtitle.textContent = 'Sign in to manage your deployments and access your TSDB clusters.';
      } else if (view === 'signup') {
        authTabsContainer?.classList.remove('hidden');
        tabSignUp?.classList.add('text-gray-900', 'bg-white', 'shadow-sm');
        tabSignUp?.classList.remove('text-gray-500');
        tabSignIn?.classList.remove('text-gray-900', 'bg-white', 'shadow-sm');
        tabSignIn?.classList.add('text-gray-500');
        signUpForm?.classList.remove('hidden');
        if (pageTitle) pageTitle.textContent = 'Create Account';
        if (pageSubtitle) pageSubtitle.textContent = 'Sign up to deploy TSDB on Cloudflare with fair BYOC pricing.';
      } else if (view === 'verify') {
        authTabsContainer?.classList.add('hidden');
        verifyForm?.classList.remove('hidden');
        if (verifyTargetEmail) verifyTargetEmail.textContent = pendingVerifyEmail;
        if (pageTitle) pageTitle.textContent = 'Verify Your Email';
        if (pageSubtitle) pageSubtitle.textContent = 'Enter the 6-digit confirmation code we sent to your inbox.';
        verifyCodeInput?.focus();
      } else if (view === 'forgot') {
        authTabsContainer?.classList.add('hidden');
        forgotForm?.classList.remove('hidden');
        forgotStep1?.classList.remove('hidden');
        forgotStep2?.classList.add('hidden');
        if (pageTitle) pageTitle.textContent = 'Reset Password';
        if (pageSubtitle) pageSubtitle.textContent = 'We will send a 6-digit code to reset your account password.';
        forgotEmailInput?.focus();
      }
    }

    tabSignIn?.addEventListener('click', () => setView('signin'));
    tabSignUp?.addEventListener('click', () => setView('signup'));
    forgotPasswordLink?.addEventListener('click', () => setView('forgot'));
    backToSignInFromVerify?.addEventListener('click', () => setView('signin'));
    backToSignInFromForgot?.addEventListener('click', () => setView('signin'));

    // Handle Sign In Submit
    signInForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const email = (document.getElementById('signInEmail') as HTMLInputElement).value.trim();
      const password = (document.getElementById('signInPassword') as HTMLInputElement).value;

      try {
        const data = await apiClient('/api/auth/login', {
          method: 'POST',
          body: JSON.stringify({ email, password }),
        });

        localStorage.setItem('zp_token', data.token);
        localStorage.setItem('zp_user', JSON.stringify(data.user));
        showAlert('Sign in successful! Redirecting...', false);

        setTimeout(() => {
          window.location.href = data.user.role === 'admin' ? '/admin/' : '/dashboard/';
        }, 500);

      } catch (err: any) {
        if (err.requiresVerification) {
          pendingVerifyEmail = err.email || email;
          setView('verify');
          showAlert('Please verify your email address before signing in.', true);
        } else {
          showAlert(err.message || 'Invalid email or password');
        }
      }
    });

    // Handle Sign Up Submit
    signUpForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const name = (document.getElementById('signUpName') as HTMLInputElement).value.trim();
      const email = (document.getElementById('signUpEmail') as HTMLInputElement).value.trim();
      const company = (document.getElementById('signUpCompany') as HTMLInputElement).value.trim();
      const password = (document.getElementById('signUpPassword') as HTMLInputElement).value;

      try {
        const data = await apiClient('/api/auth/sign-up', {
          method: 'POST',
          body: JSON.stringify({ name, email, company, password }),
        });

        if (data.requiresVerification) {
          pendingVerifyEmail = email;
          setView('verify');
          showAlert('Verification code sent! Please check your email inbox.', false);
        }

      } catch (err: any) {
        showAlert(err.message || 'Failed to create account.');
      }
    });

    // Handle Verify Email Submit
    verifyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const code = verifyCodeInput.value.trim();
      try {
        const data = await apiClient('/api/auth/verify-email', {
          method: 'POST',
          body: JSON.stringify({ email: pendingVerifyEmail, code }),
        });

        localStorage.setItem('zp_token', data.token);
        localStorage.setItem('zp_user', JSON.stringify(data.user));
        showAlert('Email verified successfully! Loading your dashboard...', false);

        setTimeout(() => {
          window.location.href = '/dashboard/';
        }, 600);

      } catch (err: any) {
        showAlert(err.message || 'Verification failed. Please check your code.');
      }
    });

    // Handle Resend Code Click
    resendCodeBtn?.addEventListener('click', async () => {
      if (!pendingVerifyEmail) return;
      try {
        await apiClient('/api/auth/resend-code', {
          method: 'POST',
          body: JSON.stringify({ email: pendingVerifyEmail }),
        });
        showAlert('A fresh verification code has been sent!', false);
      } catch (err: any) {
        showAlert(err.message || 'Could not resend code.');
      }
    });

    // Handle Forgot Password - Send Code
    sendResetCodeBtn?.addEventListener('click', async () => {
      const email = forgotEmailInput.value.trim();
      if (!email) {
        showAlert('Please enter your account email.');
        return;
      }

      try {
        await apiClient('/api/auth/forgot-password', {
          method: 'POST',
          body: JSON.stringify({ email }),
        });

        forgotStep1?.classList.add('hidden');
        forgotStep2?.classList.remove('hidden');
        showAlert('A 6-digit reset code has been sent to your email.', false);
        resetCodeInput?.focus();

      } catch (err: any) {
        showAlert(err.message || 'Error requesting reset code.');
      }
    });

    // Handle Forgot Password - Reset Submit
    forgotForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideAlert();

      const email = forgotEmailInput.value.trim();
      const code = resetCodeInput.value.trim();
      const newPassword = resetNewPasswordInput.value;

      try {
        const data = await apiClient('/api/auth/reset-password', {
          method: 'POST',
          body: JSON.stringify({ email, code, newPassword }),
        });

        setView('signin');
        showAlert(data.message || 'Password reset successful! You can now sign in.', false);

      } catch (err: any) {
        showAlert(err.message || 'Failed to reset password.');
      }
    });

    // Check incoming URL parameters (e.g. ?view=signup)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('view') === 'signup') {
      setView('signup');
    }
  </script>
</BaseLayout>
