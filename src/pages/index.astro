---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout
  title="ZoomPhant TSDB — The Time-Series Database Built for AI Agents"
  description="Give your AI Agent a private, high-speed database for monitoring, business metrics, and event analytics. 1-click deploy on your Cloudflare account. First cluster 100% free."
>
  <Header currentPath={Astro.url.pathname} />

  <main class="overflow-hidden">
    <!-- 1. HERO SECTION -->
    <section class="relative overflow-hidden pt-14 pb-20 sm:pt-20 sm:pb-28 bg-gradient-to-b from-brand-50/70 via-white to-white">
      <!-- Subtle background glow -->
      <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[420px] bg-gradient-to-tr from-brand-200/40 via-sky-100/30 to-indigo-100/40 blur-3xl rounded-full -z-10"></div>

      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
          <!-- Pill Badge -->
          <div class="inline-flex items-center gap-2 rounded-full bg-brand-50 border border-brand-200 px-4 py-1.5 text-xs font-bold text-brand-700 shadow-2xs">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-600"></span>
            </span>
            AI-Native TSDB · 100% In Your Cloud · First Cluster Free
          </div>

          <h1 class="mt-7 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-6xl lg:leading-[1.12]">
            The Time-Series Database
            <span class="mt-1.5 block bg-gradient-to-r from-brand-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent">
              Built for AI Agents.
            </span>
          </h1>

          <p class="mt-6 text-lg sm:text-xl leading-8 text-gray-600 max-w-3xl mx-auto">
            Give your AI agents a direct place to <strong>push data, ask questions, and build dashboards</strong>—whether for system monitoring, business intelligence, or product analytics. Deployed in one click into your own Cloudflare account.
          </p>

          <!-- Primary CTAs -->
          <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/dashboard/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-2xl bg-brand-600 px-8 py-4 text-sm sm:text-base font-bold text-white shadow-lg shadow-brand-500/25 transition-all hover:bg-brand-700 hover:scale-[1.01] active:scale-[0.99]"
            >
              <span>Claim Your First Free TSDB</span>
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a
              href="#how-it-works"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-2xl border border-gray-200 bg-white px-8 py-4 text-sm sm:text-base font-semibold text-gray-700 shadow-xs transition-all hover:bg-gray-50 hover:border-gray-300"
            >
              See How Agents Use It
            </a>
          </div>

          <!-- Trust Pills -->
          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm font-medium text-gray-500">
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              First TSDB Cluster 100% Free
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Runs on Cloudflare Free Tier ($0/mo)
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              60-Second 1-Click Setup
            </span>
          </div>
        </div>

        <!-- Hero Interactive Preview Card: "Just Tell Your AI Agent" -->
        <div class="mx-auto mt-14 max-w-4xl">
          <div class="rounded-3xl border border-gray-200/90 bg-white p-2 sm:p-3 shadow-2xl shadow-brand-900/5">
            <div class="rounded-2xl bg-gray-950 text-white overflow-hidden border border-gray-800">
              <!-- Top Window Bar -->
              <div class="flex items-center justify-between px-4 sm:px-6 py-3 bg-gray-900/90 border-b border-gray-800">
                <div class="flex items-center gap-2">
                  <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
                  <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
                  <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
                  <span class="ml-2 text-xs font-semibold text-gray-300">AI Agent Conversation — Claude / Cursor / Custom Agent</span>
                </div>
                <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-semibold text-emerald-300">
                  ● Connected via /llms.txt
                </span>
              </div>

              <!-- Conversation Body -->
              <div class="p-5 sm:p-7 space-y-5 text-left font-sans">
                <!-- Human Prompt -->
                <div class="flex items-start gap-3.5">
                  <div class="h-8 w-8 rounded-xl bg-brand-600 text-white flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                    YOU
                  </div>
                  <div class="rounded-2xl rounded-tl-xs bg-gray-900 border border-gray-800 px-4 py-3 text-xs sm:text-sm text-gray-200 leading-relaxed">
                    Here is my ZoomPhant TSDB (<code class="text-brand-300 font-mono">https://my-tsdb.workers.dev/llms.txt</code>) and token <code class="text-amber-300 font-mono">tsdb_live_...</code>.<br/>
                    Track every checkout order and API latency in our app, tell me why conversion dipped today, and create a daily revenue dashboard.
                  </div>
                </div>

                <!-- AI Agent Response -->
                <div class="flex items-start gap-3.5">
                  <div class="h-8 w-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-500 text-white flex items-center justify-center text-sm shrink-0 mt-0.5">
                    🤖
                  </div>
                  <div class="flex-1 rounded-2xl rounded-tl-xs bg-indigo-950/30 border border-indigo-500/30 px-4 py-3.5 text-xs sm:text-sm text-gray-200 space-y-3">
                    <div class="flex flex-wrap items-center gap-2 text-[11px] text-indigo-300 font-mono">
                      <span class="rounded bg-indigo-900/60 px-2 py-0.5">✓ Read /llms.txt</span>
                      <span class="rounded bg-indigo-900/60 px-2 py-0.5">✓ Pushed order & latency events</span>
                      <span class="rounded bg-indigo-900/60 px-2 py-0.5">✓ Queried ZQL correlation</span>
                    </div>
                    <p class="leading-relaxed text-gray-100">
                      Done! I correlated your <code class="text-cyan-300 font-mono">checkout_latency</code> metric with <code class="text-cyan-300 font-mono">order_completed</code> events. Between 14:00–14:25 UTC, payment gateway timeouts spiked on <code class="text-amber-300 font-mono">region="eu-west"</code>. I’ve also created your <strong>Revenue & Checkout Health</strong> dashboard and set up a Slack alert rule.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 2. HOW IT WORKS (3 SIMPLE STEPS) -->
    <section id="how-it-works" class="py-20 sm:py-24 bg-white border-t border-gray-100">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Effortless Workflow</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            How Your AI Agent Talks to TSDB
          </h2>
          <p class="mt-4 text-base text-gray-600">
            No complex SDKs to learn, no schemas to pre-define. Your AI agent handles the heavy lifting from day one.
          </p>
        </div>

        <div class="mx-auto mt-16 grid max-w-5xl gap-8 md:grid-cols-3">
          <!-- Step 1 -->
          <div class="relative rounded-3xl border border-gray-200 bg-gray-50/60 p-7 shadow-2xs">
            <div class="flex items-center justify-between mb-5">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-600 text-white font-extrabold text-base shadow-sm">
                1
              </span>
              <span class="rounded-full bg-orange-50 border border-orange-200 px-2.5 py-0.5 text-[11px] font-bold text-[#F6821F]">
                60 Seconds
              </span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Launch in 1 Click</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Sign in and connect your Cloudflare account. We automatically provision your private TSDB cluster, storage, and access tokens in under a minute.
            </p>
          </div>

          <!-- Step 2 -->
          <div class="relative rounded-3xl border border-gray-200 bg-gray-50/60 p-7 shadow-2xs">
            <div class="flex items-center justify-between mb-5">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-600 text-white font-extrabold text-base shadow-sm">
                2
              </span>
              <span class="rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-[11px] font-bold text-indigo-700">
                Self-Describing
              </span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Share with Your Agent</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Every TSDB cluster includes a built-in <code class="rounded bg-white px-1.5 py-0.5 text-xs font-mono border border-gray-200">/llms.txt</code> guide. Give the URL and token to any AI agent—it immediately knows how to push and query.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="relative rounded-3xl border border-gray-200 bg-gray-50/60 p-7 shadow-2xs">
            <div class="flex items-center justify-between mb-5">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-600 text-white font-extrabold text-base shadow-sm">
                3
              </span>
              <span class="rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 text-[11px] font-bold text-emerald-700">
                Zero Manual Work
              </span>
            </div>
            <h3 class="text-lg font-bold text-gray-900">Ask, Analyze & Alert</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">
              Your agent pushes metrics & events, queries trends in plain English, and even creates visual dashboards and alert rules for your team via API.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. USE CASES: ONE TSDB FOR BI, MONITORING, AND AI -->
    <section class="py-20 sm:py-24 bg-gray-50 border-y border-gray-100">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Versatile by Design</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            Whatever Your Agent Needs to Track or Analyze
          </h2>
          <p class="mt-4 text-base text-gray-600">
            Because ZoomPhant TSDB unifies numbers (metrics) and rich JSON events (logs) in one place, you can use it across your entire business and tech stack.
          </p>
        </div>

        <div class="mx-auto mt-16 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Use Case 1: Business Intelligence -->
          <div class="rounded-3xl bg-white p-7 border border-gray-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="h-12 w-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mb-5">
                📈
              </div>
              <h3 class="text-base font-bold text-gray-900">Business & Revenue BI</h3>
              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-gray-600">
                Track signups, orders, revenue by country, daily active users, and conversion funnels—without paying steep Mixpanel or Amplitude bills.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-gray-100 text-[11px] font-semibold text-emerald-700">
              ✓ Orders, MRR, DAU & Funnels
            </div>
          </div>

          <!-- Use Case 2: AI Agent Telemetry -->
          <div class="rounded-3xl bg-white p-7 border border-gray-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="h-12 w-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-2xl mb-5">
                🤖
              </div>
              <h3 class="text-base font-bold text-gray-900">AI Agent & LLM Tracking</h3>
              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-gray-600">
                Give autonomous agents a memory to record their own runs, token usage, API costs, tool execution latency, and task success rates.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-gray-100 text-[11px] font-semibold text-indigo-700">
              ✓ Token Cost, Latency & Eval Logs
            </div>
          </div>

          <!-- Use Case 3: App & API Monitoring -->
          <div class="rounded-3xl bg-white p-7 border border-gray-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="h-12 w-12 rounded-2xl bg-brand-50 text-brand-600 flex items-center justify-center text-2xl mb-5">
                ⚡
              </div>
              <h3 class="text-base font-bold text-gray-900">App & Server Monitoring</h3>
              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-gray-600">
                Monitor API response times, error rates, and server CPU/memory. When something breaks, your AI agent correlates spikes with error logs in one query.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-gray-100 text-[11px] font-semibold text-brand-700">
              ✓ Metrics + Logs in One Query
            </div>
          </div>

          <!-- Use Case 4: 1-Click Industry Templates -->
          <div class="rounded-3xl bg-white p-7 border border-gray-200 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between">
            <div>
              <div class="h-12 w-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mb-5">
                🧩
              </div>
              <h3 class="text-base font-bold text-gray-900">Instant BI Templates</h3>
              <p class="mt-2.5 text-xs sm:text-sm leading-relaxed text-gray-600">
                Start with ready-made templates for <strong>E-Commerce, SaaS, Payments, Marketing, IoT, and Web Servers</strong>—pre-configured with summaries and dashboards.
              </p>
            </div>
            <div class="mt-5 pt-4 border-t border-gray-100 text-[11px] font-semibold text-amber-700">
              ✓ 1-Click Dashboard Provisioning
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. WHY TEAMS CHOOSE ZOOMPHANT TSDB (HIGH-LEVEL BENEFITS) -->
    <section class="py-20 sm:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Why It Matters</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            Enterprise Power. Zero Complexity.
          </h2>
          <p class="mt-4 text-base text-gray-600">
            Designed so anyone—from solo founders using AI coding assistants to growing product teams—can own their data without hiring a DevOps team.
          </p>
        </div>

        <div class="mx-auto mt-16 grid max-w-5xl gap-8 sm:grid-cols-2">
          <!-- Benefit 1 -->
          <div class="rounded-3xl border border-gray-200 p-8 shadow-2xs hover:border-brand-200 transition-colors">
            <div class="flex items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">100% Data Ownership in Your Cloud</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-gray-600">
              Your business revenue, customer actions, and system logs never leave your control. Everything runs inside your own Cloudflare account—giving you complete privacy, compliance, and zero vendor lock-in.
            </p>
          </div>

          <!-- Benefit 2 -->
          <div class="rounded-3xl border border-gray-200 p-8 shadow-2xs hover:border-brand-200 transition-colors">
            <div class="flex items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Pennies to Run, No Surprise Bills</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-gray-600">
              Traditional SaaS observability and analytics tools charge hundreds of dollars as soon as you add users or events. ZoomPhant TSDB runs on Cloudflare’s <strong>Free tier ($0/mo)</strong> or <strong>Paid plan (~$5/mo)</strong>.
            </p>
          </div>

          <!-- Benefit 3 -->
          <div class="rounded-3xl border border-gray-200 p-8 shadow-2xs hover:border-brand-200 transition-colors">
            <div class="flex items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-indigo-100 text-indigo-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">AI-First + Human-Friendly</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-gray-600">
              Let your AI agents query data and manage alerts automatically—while you enjoy a clean, built-in Web Portal (and full Grafana compatibility) whenever you want to inspect charts yourself.
            </p>
          </div>

          <!-- Benefit 4 -->
          <div class="rounded-3xl border border-gray-200 p-8 shadow-2xs hover:border-brand-200 transition-colors">
            <div class="flex items-center gap-3.5">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-100 text-amber-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-gray-900">Zero Maintenance & Fast Historical Dashboards</h3>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-gray-600">
              No servers to patch, no disks that fill up, and no database tuning. Historical dashboards over months or years load instantaneously thanks to automatic background summaries.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. PRICING SECTION -->
    <section id="pricing" class="border-y border-gray-100 bg-gray-50 py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600">Transparent Pricing</span>
          <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">
            Your First TSDB is 100% Free
          </h2>
          <p class="mt-4 text-base text-gray-600">
            Launch into your own Cloudflare account in seconds. Scale with additional clusters or managed enterprise support only when you need it.
          </p>
        </div>

        <div class="mx-auto mt-16 grid max-w-5xl gap-8 lg:grid-cols-3">
          <!-- Tier 1: Starter Free -->
          <div class="rounded-3xl border-2 border-brand-500 bg-white p-8 shadow-lg relative flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-gray-900">Starter BYOC</h3>
                <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold text-emerald-800">Most Popular</span>
              </div>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="text-4xl font-extrabold text-gray-900">$0</span>
                <span class="text-sm text-gray-500 font-medium">/ forever</span>
              </div>
              <p class="mt-2 text-xs text-gray-500">Your first TSDB cluster is completely free.</p>

              <ul class="mt-6 space-y-3 text-xs sm:text-sm text-gray-600">
                <li class="flex items-center gap-2.5">
                  <svg class="h-5 w-5 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  <strong>1 Full TSDB Cluster</strong> in your Cloudflare
                </li>
                <li class="flex items-center gap-2.5">
                  <svg class="h-5 w-5 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  Built-in <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">/llms.txt</code> for AI Agents
                </li>
                <li class="flex items-center gap-2.5">
                  <svg class="h-5 w-5 shrink-0 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  Unified Metrics, Logs & Business Events
                </li>
                <li class="flex items-center gap-2.5">
